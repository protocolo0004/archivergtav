local loadingAtiva = true
local particulasLoading = {}

for i = 1, 65 do
    local particula = Instance.new("Frame")
    local tamanho = math.random(2, 4)

    particula.Size = UDim2.new(0, tamanho, 0, tamanho)
    particula.Position = UDim2.new(math.random(), 0, math.random(), 0)
    particula.BackgroundColor3 = TEMA.RoxoBrilho
    particula.BackgroundTransparency = 1
    particula.BorderSizePixel = 0
    particula.ZIndex = 1
    particula.Parent = ParticleContainer

    Instance.new("UICorner", particula).CornerRadius = UDim.new(1, 0)

    table.insert(particulasLoading, {
        Objeto = particula,
        VelX = (math.random() - 0.5) * 0.0003,
        VelY = math.random(8, 20) * 0.0001,
        Alpha = math.random(2, 6) / 10
    })
end

local conexaoParticulas = RunService.RenderStepped:Connect(function()
    if not loadingAtiva then return end

    for _, item in ipairs(particulasLoading) do
        local p = item.Objeto

        if p and p.Parent then
            local pos = p.Position
            local x = pos.X.Scale + item.VelX
            local y = pos.Y.Scale + item.VelY

            if y > 1.02 then
                y = -0.02
                x = math.random()
            end

            if x < -0.02 or x > 1.02 then
                x = math.random()
            end

            p.Position = UDim2.new(x, 0, y, 0)
        end
    end
end)

local function TweenLoading(objeto, tempo, propriedades)
    local tween = TweenService:Create(objeto, TweenInfo.new(tempo, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), propriedades)
    tween:Play()
    return tween
end

TweenLoading(LoadingBlur, 0.8, {Size = 12})
TweenLoading(LoadingMain, 0.8, {BackgroundTransparency = 0.45})

task.wait(0.15)

TweenLoading(LoadingGlow, 0.8, {ImageTransparency = 0.5})
TweenLoading(LoadingLogo, 0.8, {ImageTransparency = 0})
TweenLoading(LoadingTitle, 0.8, {TextTransparency = 0})
TweenLoading(LoadingStatus, 0.8, {TextTransparency = 0})
TweenLoading(LoadingBarBg, 0.8, {BackgroundTransparency = 0})
TweenLoading(LoadingBarStroke, 0.8, {Transparency = 0})
TweenLoading(ProgressBar, 0.8, {BackgroundTransparency = 0})
TweenLoading(LoadingPercent, 0.8, {TextTransparency = 0})
TweenLoading(LoadingTip, 0.8, {BackgroundTransparency = 0})
TweenLoading(TipStroke, 0.8, {Transparency = 0})
TweenLoading(TipIcon, 0.8, {ImageTransparency = 0})
TweenLoading(TipText, 0.8, {TextTransparency = 0})
TweenLoading(LoadingFooter, 0.8, {TextTransparency = 0})

task.spawn(function()
    local pontos = 0
    while loadingAtiva do
        pontos = (pontos + 1) % 4
        LoadingTitle.Text = "INICIANDO" .. string.rep(".", pontos)
        task.wait(0.5)
    end
end)

