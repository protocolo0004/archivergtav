    LabelDesc.BackgroundTransparency = 1
    LabelDesc.Font = Enum.Font.Gotham
    LabelDesc.Text = "Altere a tecla de PC usada para ocultar o menu."
    LabelDesc.TextColor3 = TEMA.TextoEscuro
