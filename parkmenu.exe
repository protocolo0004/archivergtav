    BindBtn.Text = "K"
    BindBtn.TextColor3 = TEMA.TextoBranco
    BindBtn.TextSize = 13
    BindBtn.ZIndex = 5
    BindBtn.Parent = Card

    Instance.new("UICorner", BindBtn).CornerRadius = UDim.new(0, 6)
    botaoKeybindComponente = BindBtn

    BindBtn.MouseButton1Click:Connect(function()
        if aguardandoNovaTecla then return end
        aguardandoNovaTecla = true
        BindBtn.Text = "..."
        BindBtn.BackgroundColor3 = TEMA.BotaoPause
    end)
end

