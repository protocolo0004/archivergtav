    LabelDesc.TextXAlignment = Enum.TextXAlignment.Left
    LabelDesc.TextYAlignment = Enum.TextYAlignment.Top
    LabelDesc.TextWrapped = true
    LabelDesc.ZIndex = 4
    LabelDesc.Parent = Card

    local BindBtn = Instance.new("TextButton")
    BindBtn.Size = UDim2.new(0, 85, 0, 38)
    BindBtn.Position = UDim2.new(0.97, 0, 0.5, 0)
    BindBtn.AnchorPoint = Vector2.new(1, 0.5)
    BindBtn.BackgroundColor3 = TEMA.CardAbaAtiva
