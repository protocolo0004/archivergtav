    local Cores = {
        {Cor = Color3.fromRGB(157, 0, 255), Pos = 0.45}, 
        {Cor = Color3.fromRGB(255, 30, 30), Pos = 0.58},  
        {Cor = Color3.fromRGB(30, 144, 255), Pos = 0.71}, 
        {Cor = Color3.fromRGB(30, 235, 100), Pos = 0.84}  
    }

    for _, configCor in ipairs(Cores) do
        local BtnCor = Instance.new("TextButton")
        BtnCor.Size = UDim2.new(0, 26, 0, 26)
        BtnCor.Position = UDim2.new(configCor.Pos, 0, 0.5, -13)
        BtnCor.BackgroundColor3 = configCor.Cor
        BtnCor.Text = ""
        BtnCor.ZIndex = 5
        BtnCor.Parent = Card

        Instance.new("UICorner", BtnCor).CornerRadius = UDim.new(1, 0)

        BtnCor.MouseButton1Click:Connect(function()
            HitboxConfig.Cor = configCor.Cor
        end)
    end
end

local function CriarPainelWhitelist(abaPertencente)
    local Card = Instance.new("Frame")
    Card.Name = abaPertencente .. "_Card"
    Card.Size = UDim2.new(1, -6, 0, alturaCardsEOpcoes + 12)
    Card.BackgroundColor3 = TEMA.CardFuncao
    Card.BackgroundTransparency = 0.05
    Card.Visible = false
    Card.ZIndex = 3
    Card.Parent = ContentFrame

    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 10)

    local CampoTexto = Instance.new("TextBox")
    CampoTexto.Size = UDim2.new(0.55, 0, 0, 34)
    CampoTexto.Position = UDim2.new(0, 12, 0.5, -17)
    CampoTexto.BackgroundColor3 = Color3.fromRGB(12, 7, 20)
    CampoTexto.Font = Enum.Font.GothamSemibold
    CampoTexto.PlaceholderText = "Nick do amigo..."
    CampoTexto.Text = ""
    CampoTexto.TextColor3 = TEMA.TextoBranco
    CampoTexto.PlaceholderColor3 = TEMA.TextoEscuro
    CampoTexto.TextSize = 12
    CampoTexto.ClearTextOnFocus = true
    CampoTexto.ZIndex = 5
    CampoTexto.Parent = Card

    Instance.new("UICorner", CampoTexto).CornerRadius = UDim.new(0, 6)

    local AddBtn = Instance.new("TextButton")
    AddBtn.Size = UDim2.new(0, 62, 0, 34)
    AddBtn.Position = UDim2.new(0.6, 5, 0.5, -17)
    AddBtn.BackgroundColor3 = TEMA.BotaoPlay
    AddBtn.Font = Enum.Font.GothamBold
    AddBtn.Text = "ADD"
    AddBtn.TextColor3 = TEMA.TextoBranco
    AddBtn.TextSize = 11
    AddBtn.ZIndex = 5
    AddBtn.Parent = Card

    Instance.new("UICorner", AddBtn).CornerRadius = UDim.new(0, 6)

    local ClearBtn = Instance.new("TextButton")
    ClearBtn.Size = UDim2.new(0, 62, 0, 34)
    ClearBtn.Position = UDim2.new(0.8, 8, 0.5, -17)
    ClearBtn.BackgroundColor3 = TEMA.BotaoPause
    ClearBtn.Font = Enum.Font.GothamBold
    ClearBtn.Text = "LIMPAR"
    ClearBtn.TextColor3 = TEMA.TextoBranco
    ClearBtn.TextSize = 11
    ClearBtn.ZIndex = 5
    ClearBtn.Parent = Card

    Instance.new("UICorner", ClearBtn).CornerRadius = UDim.new(0, 6)

    AddBtn.MouseButton1Click:Connect(function()
        if CampoTexto.Text ~= "" then
            table.insert(HitboxConfig.Whitelist, CampoTexto.Text)
            CampoTexto.Text = "ADICIONADO!"
            task.wait(1)
            CampoTexto.Text = ""
        end
    end)

    ClearBtn.MouseButton1Click:Connect(function()
        HitboxConfig.Whitelist = {}
        CampoTexto.Text = "RESETADO!"
        task.wait(1)
        CampoTexto.Text = ""
    end)
end

