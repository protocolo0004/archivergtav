local estadoJanelasFisicas = {MenuVisivel = true, BolinhaVisivel = false}

UserInputService.InputBegan:Connect(function(input, gProcessed)
    if LoadingScreenGui.Parent then return end
    
    if aguardandoNovaTecla and input.UserInputType == Enum.UserInputType.Keyboard then
        teclaAtalhoAtiva = input.KeyCode
        aguardandoNovaTecla = false
        if botaoKeybindComponente then
            botaoKeybindComponente.Text = string.upper(input.KeyCode.Name)
            botaoKeybindComponente.BackgroundColor3 = TEMA.CardAbaAtiva
        end
        return
    end

    if gProcessed then return end

    if input.KeyCode == teclaAtalhoAtiva then
        if BaseContainer.Visible or FloatingBall.Visible then
            estadoJanelasFisicas.MenuVisivel = BaseContainer.Visible
            estadoJanelasFisicas.BolinhaVisivel = FloatingBall.Visible
            BaseContainer.Visible = false
            FloatingBall.Visible = false
        else
            BaseContainer.Visible = estadoJanelasFisicas.MenuVisivel
            FloatingBall.Visible = estadoJanelasFisicas.BolinhaVisivel
            if not BaseContainer.Visible and not FloatingBall.Visible then
                BaseContainer.Visible = true
            end
        end
    end
end)

MinBtn.MouseButton1Click:Connect(function()
    BaseContainer.Visible = false
    FloatingBall.Position = PosicaoBolinhaSalva
    FloatingBall.Visible = true
end)

CloseBtn.MouseButton1Click:Connect(function()
    MainGui:Destroy()
end)

-- =============================================================================
-- SISTEMA DE ARRASTO MOBILE E PC
-- =============================================================================
local function configurarArrastoEClick(objetoMovel, objetoClique, ehBolinha)
    local dragging, dragInput, dragStart, startPos
    local totalMovido = 0
    local instanteClique = 0

    objetoClique.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            totalMovido = 0
            instanteClique = os.clock()
            dragStart = input.Position
            startPos = objetoMovel.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if ehBolinha and totalMovido < 8 and (os.clock() - instanteClique) < 0.35 then
                        if FloatingBall.Visible then
                            FloatingBall.Visible = false
                            BaseContainer.Visible = true
                        end
                    end
                end
            end)
        end
    end)

    objetoClique.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            totalMovido = totalMovido + delta.Magnitude
            local novaPosicao = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            objetoMovel.Position = novaPosicao
            if ehBolinha then 
                PosicaoBolinhaSalva = novaPosicao 
            end
        end
    end)
end

configurarArrastoEClick(BaseContainer, BaseContainer, false)
configurarArrastoEClick(FloatingBall, FloatingBall, true)

-- =============================================================================
-- DOWNLOAD DE CACHE E INICIALIZAÇÃO
-- =============================================================================
task.spawn(function()
    local filaDownloads = {}

    -- Montagem da fila de downloads a partir da tabela RAW_URLS
    for catNome, subData in pairs(RAW_URLS) do
        if catNome == "Parkours" then
            for pkNome, modos in pairs(subData) do
                for modoNome, url in pairs(modos) do
                    if url and url ~= "" then
                        table.insert(filaDownloads, {
                            chave = string.gsub(pkNome, "^%s*(.-)%s*$", "%1") .. "-" .. string.gsub(modoNome, "^%s*(.-)%s*$", "%1"),
                            url = url
                        })
                    end
                end
            end
        elseif catNome == "Torres" then
            for torreNome, url in pairs(subData) do
                if url and url ~= "" then
                    table.insert(filaDownloads, {
                        chave = "Torres-" .. string.gsub(torreNome, "^%s*(.-)%s*$", "%1"),
                        url = url
                    })
                end
            end
        end
    end

    local totalArquivos = #filaDownloads

    warn("--------------------------------------------")
    warn("[HAVAC] Iniciando carregamento dos saves...")
    warn("[HAVAC] Total de arquivos: " .. totalArquivos)
    warn("--------------------------------------------")

    for i, item in ipairs(filaDownloads) do
        local inicio = tick()

        LoadingStatus.Text = string.format(
            "Baixando (%d/%d)\n%s",
            i,
            totalArquivos,
            item.chave
        )

        warn(string.format(
            "[%02d/%02d] Baixando -> %s",
            i,
            totalArquivos,
            item.chave
        ))

        local sucesso, conteudo = pcall(function()
            return game:HttpGet(item.url)
        end)

        if sucesso and conteudo then
            local sucessoJson, dadosDecodificados = pcall(function()
                return HttpService:JSONDecode(conteudo)
            end)

            if sucessoJson and dadosDecodificados then
                dadosTrajetosCarregados[item.chave] =
                    dadosDecodificados[1]
                    and dadosDecodificados[1].dados
                    and dadosDecodificados[1]
                    or dadosDecodificados

                warn(string.format(
                    "[%02d/%02d] ✓ %s (%.2fs)",
                    i,
                    totalArquivos,
                    item.chave,
                    tick() - inicio
                ))
            else
                warn(string.format(
                    "[%02d/%02d] ✗ JSON inválido -> %s",
                    i,
                    totalArquivos,
                    item.chave
                ))
            end
        else
            warn(string.format(
                "[%02d/%02d] ✗ Erro HTTP -> %s",
                i,
                totalArquivos,
                item.chave
            ))
        end

        local porcentagemAlvo = i / totalArquivos

        TweenService:Create(
            ProgressBar,
            TweenInfo.new(
                0.12,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                Size = UDim2.new(
                    porcentagemAlvo,
                    0,
                    1,
                    0
                )
            }
        ):Play()

        LoadingPercent.Text = tostring(math.floor(porcentagemAlvo * 100)) .. "%"

        task.wait(0.04)
    end

    warn("--------------------------------------------")
    warn("[HAVAC] Todos os saves carregados!")
    warn("--------------------------------------------")

    LoadingStatus.Text = "Interface carregada com sucesso."
    LoadingTitle.Text = "CONCLUÍDO"
    LoadingPercent.Text = "100%"

    TweenLoading(
        LoadingTitle,
        0.25,
        {
            TextColor3 = TEMA.RoxoBrilho
        }
    )

    task.wait(1.1)

    loadingAtiva = false

    if conexaoParticulas then
        conexaoParticulas:Disconnect()
    end

    local tempoSaida = 0.55

    TweenLoading(LoadingBlur, tempoSaida, {Size = 0})
    TweenLoading(LoadingGlow, tempoSaida, {ImageTransparency = 1})
    TweenLoading(LoadingLogo, tempoSaida, {ImageTransparency = 1})
    TweenLoading(LoadingTitle, tempoSaida, {TextTransparency = 1})
    TweenLoading(LoadingStatus, tempoSaida, {TextTransparency = 1})
    TweenLoading(LoadingBarBg, tempoSaida, {BackgroundTransparency = 1})
    TweenLoading(LoadingBarStroke, tempoSaida, {Transparency = 1})
    TweenLoading(ProgressBar, tempoSaida, {BackgroundTransparency = 1})
    TweenLoading(LoadingPercent, tempoSaida, {TextTransparency = 1})
    TweenLoading(LoadingTip, tempoSaida, {BackgroundTransparency = 1})
    TweenLoading(TipStroke, tempoSaida, {Transparency = 1})
    TweenLoading(TipIcon, tempoSaida, {ImageTransparency = 1})
    TweenLoading(TipText, tempoSaida, {TextTransparency = 1})
    TweenLoading(LoadingFooter, tempoSaida, {TextTransparency = 1})

    local tweenFim = TweenLoading(
        LoadingMain,
        tempoSaida,
        {
            BackgroundTransparency = 1
        }
    )

    tweenFim.Completed:Wait()

    if LoadingBlur then
        LoadingBlur:Destroy()
    end

    LoadingScreenGui:Destroy()
    BaseContainer.Visible = true
end)
