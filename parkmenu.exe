local function CriarSliderHitbox(abaPertencente, titulo, valorMin, valorMax, sufixo, campoConfig)
    local Card = Instance.new("Frame")
    Card.Name = abaPertencente .. "_Card"
    Card.Size = UDim2.new(1, -6, 0, alturaCardsEOpcoes)
    Card.BackgroundColor3 = TEMA.CardFuncao
    Card.BackgroundTransparency = 0.05
    Card.Visible = false
    Card.ZIndex = 3
    Card.Parent = ContentFrame

    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 10)

    local LabelTitulo = Instance.new("TextLabel")
    LabelTitulo.Size = UDim2.new(0.4, 0, 0, 20)
    LabelTitulo.Position = UDim2.new(0, 15, 0, 8)
    LabelTitulo.BackgroundTransparency = 1
    LabelTitulo.Font = Enum.Font.GothamBold
    LabelTitulo.Text = string.upper(titulo)
    LabelTitulo.TextColor3 = TEMA.TextoBranco
    LabelTitulo.TextSize = 12
    LabelTitulo.TextXAlignment = Enum.TextXAlignment.Left
    LabelTitulo.ZIndex = 4
    LabelTitulo.Parent = Card

    local LabelValor = Instance.new("TextLabel")
    LabelValor.Size = UDim2.new(0.2, 0, 0, 20)
    LabelValor.Position = UDim2.new(0.8, -15, 0, 8)
    LabelValor.BackgroundTransparency = 1
    LabelValor.Font = Enum.Font.GothamBold
    local valorInicialCompleto = HitboxConfig[campoConfig]
    if campoConfig == "Transparencia" then valorInicialCompleto = (1 - valorInicialCompleto) * 10 end
    LabelValor.Text = tostring(math.floor(valorInicialCompleto)) .. sufixo
    LabelValor.TextColor3 = TEMA.RoxoBrilho
    LabelValor.TextSize = 12
    LabelValor.TextXAlignment = Enum.TextXAlignment.Right
    LabelValor.ZIndex = 4
    LabelValor.Parent = Card

    local SliderBarraBg = Instance.new("TextButton")
    SliderBarraBg.Size = UDim2.new(1, -30, 0, 10)
    SliderBarraBg.Position = UDim2.new(0, 15, 1, -18)
    SliderBarraBg.BackgroundColor3 = Color3.fromRGB(30, 20, 45)
    SliderBarraBg.Text = ""
    SliderBarraBg.AutoButtonColor = false
    SliderBarraBg.ZIndex = 4
    SliderBarraBg.Parent = Card

    Instance.new("UICorner", SliderBarraBg).CornerRadius = UDim.new(0.5, 0)

    local SliderBarraAtiva = Instance.new("Frame")
    local percentualInicial = (HitboxConfig[campoConfig] - valorMin) / (valorMax - valorMin)
    if campoConfig == "Transparencia" then percentualInicial = 1 - HitboxConfig[campoConfig] end
    SliderBarraAtiva.Size = UDim2.new(percentualInicial, 0, 1, 0)
    SliderBarraAtiva.BackgroundColor3 = TEMA.RoxoBrilho
    SliderBarraAtiva.BorderSizePixel = 0
    SliderBarraAtiva.ZIndex = 5
    SliderBarraAtiva.Parent = SliderBarraBg

    Instance.new("UICorner", SliderBarraAtiva).CornerRadius = UDim.new(0.5, 0)

    local manipulando = false

    local function atualizarPosicaoSlider(inputX)
        local deltaX = math.clamp((inputX - SliderBarraBg.AbsolutePosition.X) / SliderBarraBg.AbsoluteSize.X, 0, 1)
        SliderBarraAtiva.Size = UDim2.new(deltaX, 0, 1, 0)

        local valorCalculado = valorMin + (deltaX * (valorMax - valorMin))
        if campoConfig == "Transparencia" then
            HitboxConfig.Transparencia = 1 - deltaX
            LabelValor.Text = tostring(math.floor(deltaX * 10)) .. sufixo
        else
            HitboxConfig[campoConfig] = math.floor(valorCalculado)
            LabelValor.Text = tostring(math.floor(valorCalculado)) .. sufixo
        end
    end

    SliderBarraBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            manipulando = true
            atualizarPosicaoSlider(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if manipulando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            atualizarPosicaoSlider(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            manipulando = false
        end
    end)
end

