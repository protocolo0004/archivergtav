ContentFrame.ScrollBarThickness = 3
ContentFrame.ScrollBarImageColor3 = TEMA.RoxoBrilho
ContentFrame.ZIndex = 3
ContentFrame.Parent = MainPanel

local ContentLayout = Instance.new("UIListLayout")
ContentLayout.Padding = UDim.new(0, 8)
ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
ContentLayout.Parent = ContentFrame

ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    ContentFrame.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 20)
end)

local AbasInstanciadas = {}

local function IniciarTween(obj, tempo, config)
    TweenService:Create(obj, TweenInfo.new(tempo, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), config):Play()
end

-- =============================================================================
-- LOGICA DO LOOP DOS TRAJETOS (CORRIGIDA)
-- =============================================================================
-- Função para encontrar o estado de animação correto no Roblox
local function obterEnumEstado(valorEstado)
    if type(valorEstado) == "number" then
        for _, enumItem in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
            if enumItem.Value == valorEstado then
                return enumItem
            end
        end
    elseif type(valorEstado) == "string" and Enum.HumanoidStateType[valorEstado] then
        return Enum.HumanoidStateType[valorEstado]
    end
    return Enum.HumanoidStateType.Running
end

-- Bloco corrigido
RunService.PostSimulation:Connect(function(deltaTime)
    if reproduzindo and rootPart and humanoid and slotAtivo and not emTransicao then
        tempoDecorrido = tempoDecorrido + deltaTime
        local historico = slotAtivo.dados
        
        local dadosAlvo = nil
        for i = #historico, 1, -1 do
            if historico[i].tempo <= tempoDecorrido then
                dadosAlvo = historico[i]
                break
            end
        end
        
        if not dadosAlvo and tempoDecorrido < 0.1 then
            dadosAlvo = historico[1]
        end
        
        if tempoDecorrido >= slotAtivo.tempoTotal or not dadosAlvo then
            reproduzindo = false
            humanoid.PlatformStand = false
            if slotAtivo and botoesCardsInstanciados[slotAtivo.idUnico] then
                botoesCardsInstanciados[slotAtivo.idUnico].Text = "PLAY"
                IniciarTween(botoesCardsInstanciados[slotAtivo.idUnico], 0.2, {BackgroundColor3 = TEMA.BotaoPlay})
            end
            slotAtivo = nil
        else
            local posX = slotAtivo.posicaoStart[1] + dadosAlvo.offX
            local posY = slotAtivo.posicaoStart[2] + dadosAlvo.offY
            local posZ = slotAtivo.posicaoStart[3] + dadosAlvo.offZ
            
            rootPart.AssemblyLinearVelocity = Vector3.new(dadosAlvo.velX, dadosAlvo.velY, dadosAlvo.velZ)
            rootPart.CFrame = CFrame.new(posX, posY, posZ) * CFrame.fromEulerAnglesYXZ(0, dadosAlvo.rotY, 0)
            
            -- Aplica o estado de animação correto lido do JSON
            if dadosAlvo.estado ~= nil then
                pcall(function()
                    local estadoEnum = obterEnumEstado(dadosAlvo.estado)
                    humanoid:ChangeState(estadoEnum)
                end)
            end
        end
    end
end)
-- =============================================================================
-- FUNÇÃO DE ATIVAÇÃO COM RETORNO DO MOVETO LEGIT
-- =============================================================================
local function alternarEstadoTrajeto(nomeAba, nomeBotao, btnComponente)
    if emTransicao then return end

    local abaLimpa = string.gsub(nomeAba, "^%s*(.-)%s*$", "%1")
    local botaoLimpo = string.gsub(nomeBotao, "^%s*(.-)%s*$", "%1")
    local chaveUnica = abaLimpa .. "-" .. botaoLimpo

    if reproduzindo and slotAtivo and slotAtivo.idUnico == chaveUnica then
        reproduzindo = false
        humanoid.PlatformStand = false
        btnComponente.Text = "PLAY"
        IniciarTween(btnComponente, 0.2, {BackgroundColor3 = TEMA.BotaoPlay})
        slotAtivo = nil
        return
    end

    if reproduzindo then
        reproduzindo = false
        humanoid.PlatformStand = false
        for _, btn in pairs(botoesCardsInstanciados) do
            btn.Text = "PLAY"
            btn.BackgroundColor3 = TEMA.BotaoPlay
        end
        task.wait(0.05)
    end

    local dadosDoTrajeto = dadosTrajetosCarregados[chaveUnica]
    if dadosDoTrajeto and rootPart and humanoid then
        local historico = dadosDoTrajeto.dados or (type(dadosDoTrajeto) == "table" and dadosDoTrajeto)
        if not historico or #historico == 0 then return end

        tempoDecorrido = 0
        local posStart = dadosDoTrajeto.posicaoStart or {rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z}
        
        local primeiroFrame = historico[1]
        local offX = primeiroFrame and primeiroFrame.offX or 0
        local offY = primeiroFrame and primeiroFrame.offY or 0
        local offZ = primeiroFrame and primeiroFrame.offZ or 0
        local rotYAlvo = primeiroFrame and primeiroFrame.rotY or 0

        local pontoAlvo = Vector3.new(posStart[1] + offX, posStart[2] + offY, posStart[3] + offZ)
        local targetCFrame = CFrame.new(pontoAlvo) * CFrame.fromEulerAnglesYXZ(0, rotYAlvo, 0)
        
        slotAtivo = {
            nome = nomeBotao,
            idUnico = chaveUnica,
            dados = historico,
            posicaoStart = posStart,
            tempoTotal = dadosDoTrajeto.tempoTotal
        }

        btnComponente.Text = "PAUSE"
        IniciarTween(btnComponente, 0.2, {BackgroundColor3 = TEMA.BotaoPause})

        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        humanoid:ChangeState(Enum.HumanoidStateType.Running)

        local distancia = (rootPart.Position - pontoAlvo).Magnitude
        
        if distancia > 1.5 and distancia < 35 then
            emTransicao = true
            humanoid:MoveTo(pontoAlvo)
            
            local chegou = false
            local conexao
            conexao = humanoid.MoveToFinished:Connect(function()
                chegou = true
                if conexao then conexao:Disconnect() end
            end)
            
            local inicioEspera = os.clock()
            while not chegou and (os.clock() - inicioEspera < 2.5) do
                if (rootPart.Position - pontoAlvo).Magnitude <= 1.5 then
                    chegou = true
                    break
                end
                task.wait()
            end
            if conexao and conexao.Connected then conexao:Disconnect() end

            humanoid.AutoRotate = false
            local tweenGiro = TweenService:Create(rootPart, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = targetCFrame})
            tweenGiro:Play()
            tweenGiro.Completed:Wait()
            
            humanoid.AutoRotate = true
            emTransicao = false
        else
            rootPart.CFrame = targetCFrame
            task.wait(0.02)
        end
        
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        
        humanoid.PlatformStand = true
        reproduzindo = true
    end
end

-- =============================================================================
-- ENGINE MODIFICADOR DE HITBOX
-- =============================================================================
local function checarNaWhitelist(vPlayer)
    if vPlayer == player then return true end
    for _, item in ipairs(HitboxConfig.Whitelist) do
        if string.find(string.lower(vPlayer.Name), string.lower(item)) or string.find(string.lower(vPlayer.DisplayName), string.lower(item)) then
            return true
        end
    end
    return false
end

task.spawn(function()
    while task.wait(0.2) do
        if not MainGui or not MainGui.Parent then break end
        if HitboxConfig.Tamanho > 0 then
            for _, p in ipairs(Players:GetPlayers()) do
                if not checarNaWhitelist(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    hrp.Size = Vector3.new(HitboxConfig.Tamanho, HitboxConfig.Tamanho, HitboxConfig.Tamanho)
                    hrp.Transparency = HitboxConfig.Transparencia
                    hrp.Color = HitboxConfig.Cor
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                end
            end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.CanCollide = false
                end
            end
        end
    end
end)

-- =============================================================================
-- GERADORES DA INTERFACE DINÂMICA
-- =============================================================================
local function CriarAba(nome, layoutOrder, idIcone)
    local iconeSelecionado = idIcone or ASSETS.IconeCorrer

    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(1, 0, 0, alturaCardsEOpcoes)
    TabBtn.BackgroundColor3 = layoutOrder == 1 and TEMA.CardAbaAtiva or TEMA.CardAba
    TabBtn.BackgroundTransparency = 0.05
    TabBtn.AutoButtonColor = false
    TabBtn.Text = ""
    TabBtn.LayoutOrder = layoutOrder
    TabBtn.ZIndex = 4
    TabBtn.Parent = TabListContainer

    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 10)

    local IconBox = Instance.new("ImageLabel")
    IconBox.Size = UDim2.new(0, 20, 0, 20)
    IconBox.Position = UDim2.new(0, 14, 0.5, -10)
    IconBox.BackgroundTransparency = 1
    IconBox.Image = iconeSelecionado
    IconBox.ScaleType = Enum.ScaleType.Fit
    IconBox.ImageColor3 = layoutOrder == 1 and TEMA.RoxoBrilho or TEMA.TextoEscuro
    IconBox.ZIndex = 5
    IconBox.Parent = TabBtn

    local LabelAba = Instance.new("TextLabel")
    LabelAba.Size = UDim2.new(1, -52, 1, 0)
    LabelAba.Position = UDim2.new(0, 44, 0, 0)
    LabelAba.BackgroundTransparency = 1
    LabelAba.Font = Enum.Font.GothamBold
    LabelAba.Text = string.upper(nome)
    LabelAba.TextColor3 = layoutOrder == 1 and TEMA.TextoBranco or TEMA.TextoEscuro
    LabelAba.TextSize = 12
    LabelAba.TextXAlignment = Enum.TextXAlignment.Left
    LabelAba.ZIndex = 5
    LabelAba.Parent = TabBtn

    AbasInstanciadas[nome] = {
        Botao = TabBtn,
        Icone = IconBox,
        Texto = LabelAba,
        AssetId = iconeSelecionado
    }

    TabBtn.MouseButton1Click:Connect(function()
        TabTitle.Text = string.upper(nome)
        HeaderIcon.Image = iconeSelecionado

        for k, aba in pairs(AbasInstanciadas) do
            if k == nome then
                IniciarTween(aba.Botao, 0.2, {BackgroundColor3 = TEMA.CardAbaAtiva})
                IniciarTween(aba.Texto, 0.2, {TextColor3 = TEMA.TextoBranco})
                IniciarTween(aba.Icone, 0.2, {ImageColor3 = TEMA.RoxoBrilho})
            else
                IniciarTween(aba.Botao, 0.2, {BackgroundColor3 = TEMA.CardAba})
                IniciarTween(aba.Texto, 0.2, {TextColor3 = TEMA.TextoEscuro})
                IniciarTween(aba.Icone, 0.2, {ImageColor3 = TEMA.TextoEscuro})
            end
        end

        for _, funcCard in ipairs(ContentFrame:GetChildren()) do
            if funcCard:IsA("Frame") then
                funcCard.Visible = funcCard.Name == nome .. "_Card"
            end
        end
    end)
end

