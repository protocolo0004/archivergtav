local function gerarNomeAleatorio(tamanho)
    local caracteres = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local nome = ""
    for i = 1, tamanho or 14 do
        local rand = math.random(1, #caracteres)
        nome = nome .. string.sub(caracteres, rand, rand)
    end
    return nome
end

