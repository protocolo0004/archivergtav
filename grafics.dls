local function fazerElementoMovel(instanciaAtivadora, instanciaAlvo)
    local dragging, dragInput, dragStart, startPos
    instanciaAtivadora.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = instanciaAlvo.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    instanciaAtivadora.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            instanciaAlvo.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

fazerElementoMovel(Header, MainFrame)
fazerElementoMovel(BtnToggle, BtnToggle)

-- COMANDO PARA FECHAR E APAGAR A INTERFACE TOTALMENTE
local function fecharInterface()
    sg.Enabled = false
    sg:Destroy()
end

local TextChatService = game:GetService("TextChatService")
pcall(function()
    local cmdFechar = Instance.new("TextChatCommand")
    cmdFechar.Name = "fechar"
    cmdFechar.PrimaryAlias = "/fechar"
    cmdFechar.SecondaryAlias = "/delete"
    cmdFechar.Parent = TextChatService
    
    cmdFechar.Triggered:Connect(fecharInterface)
end)
