    return btn
end

local BtnKeybind = criarBotaoPopup("Atalho: Nenhum", UDim2.new(0, 6, 0, 26), UDim2.new(1, -12, 0, 26), Color3.fromRGB(24, 24, 32))
local BtnLoopCheck = criarBotaoPopup("Loop: DESATIVADO", UDim2.new(0, 6, 0, 56), UDim2.new(1, -12, 0, 26), Color3.fromRGB(24, 24, 32))

local BtnDeletar = criarBotaoPopup("Excluir", UDim2.new(0, 6, 0, 104), UDim2.new(0.5, -9, 0, 26), Color3.fromRGB(180, 40, 50))
local BtnCancelar = criarBotaoPopup("Fechar", UDim2.new(0.5, 3, 0, 104), UDim2.new(0.5, -9, 0, 26), Color3.fromRGB(36, 36, 48))

local slotSelecionadoPopup = nil
local escutandoTeclado = false

local function fecharPopupConfig()
    PopupFrame.Visible = false
    slotSelecionadoPopup = nil
    escutandoTeclado = false
end

BtnCancelar.MouseButton1Click:Connect(fecharPopupConfig)

BtnDeletar.MouseButton1Click:Connect(function()
    if slotSelecionadoPopup then
        local alvo = slotSelecionadoPopup.dados
        if slotAtivo == alvo then reproduzindo = false StatusBadge.Text = "Neutro" StatusBadge.TextColor3 = Color3.fromRGB(160, 160, 170) end
        removerLinhaDoSlot(alvo)
        for i, v in ipairs(listaSalvados) do if v == alvo then table.remove(listaSalvados, i) break end end
        slotSelecionadoPopup.frameUI:Destroy()
        salvarListaEmArquivo()
        fecharPopupConfig()
    end
end)

BtnKeybind.MouseButton1Click:Connect(function()
    if not slotSelecionadoPopup then return end
    if escutandoTeclado then
        slotSelecionadoPopup.dados.keybind = nil
        BtnKeybind.Text = "Atalho: Nenhum"
        escutandoTeclado = false
        salvarListaEmArquivo()
    else
        escutandoTeclado = true
        BtnKeybind.Text = "Aperte uma tecla..."
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if escutandoTeclado and input.UserInputType == Enum.UserInputType.MouseButton1 then
        task.delay(0.1, function()
            if escutandoTeclado then
                escutandoTeclado = false
                if slotSelecionadoPopup then
                    BtnKeybind.Text = "Atalho: " .. (slotSelecionadoPopup.dados.keybind and slotSelecionadoPopup.dados.keybind.Name or "Nenhum")
                end
            end
        end)
        return
    end

    if gameProcessed then return end
    
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.K then
        guiVisivelGeral = not guiVisivelGeral
        sg.Enabled = guiVisivelGeral
        return
    end
end)

BtnLoopCheck.MouseButton1Click:Connect(function()
    if slotSelecionadoPopup then
        slotSelecionadoPopup.dados.loopAtivo = not slotSelecionadoPopup.dados.loopAtivo
        BtnLoopCheck.Text = "Loop: " .. (slotSelecionadoPopup.dados.loopAtivo and "ATIVADO ✅" or "DESATIVADO ❌")
        salvarListaEmArquivo()
    end
end)

BtnSlowToggle.MouseButton1Click:Connect(function()
    gravarEmSlow = not gravarEmSlow
    if gravarEmSlow then
        BtnSlowToggle.Text = "🐢 Camera lenta: ON"
        BtnSlowToggle.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
    else
        BtnSlowToggle.Text = "🐢 Camera lenta: OFF"
        BtnSlowToggle.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
    end
end)

-- VER ROTA DA ÚLTIMA GRAVAÇÃO TEMPORÁRIA
local exibindoUltimaLinha = false
local slotUltimaTemp = nil

BtnVerUltimaRota.MouseButton1Click:Connect(function()
    if #gravacaoTemporaria > 0 and posicaoInicial then
        exibindoUltimaLinha = not exibindoUltimaLinha
        if exibindoUltimaLinha then
            BtnVerUltimaRota.BackgroundColor3 = Color3.fromRGB(130, 80, 240)
            slotUltimaTemp = {
                id = "Temp",
                dados = gravacaoTemporaria,
                posicaoStart = {posicaoInicial.X, posicaoInicial.Y, posicaoInicial.Z}
            }
            desenharRota3D(slotUltimaTemp, Color3.fromRGB(255, 215, 0))
        else
            BtnVerUltimaRota.BackgroundColor3 = Color3.fromRGB(36, 36, 48)
            if slotUltimaTemp then removerLinhaDoSlot(slotUltimaTemp) end
        end
    end
end)

local function criarItemLista(slotDados)
    local ItemFrame = Instance.new("Frame", ScrollLista)
    ItemFrame.Size = UDim2.new(1, -4, 0, 28)
    ItemFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    ItemFrame.BorderSizePixel = 0
    Instance.new("UICorner", ItemFrame).CornerRadius = UDim.new(0, 5)
    
    local TextBox = Instance.new("TextBox", ItemFrame)
    TextBox.Size = UDim2.new(1, -78, 1, 0)
    TextBox.Position = UDim2.new(0, 6, 0, 0)
    TextBox.BackgroundTransparency = 1
    TextBox.Text = slotDados.nome
    TextBox.TextColor3 = Color3.fromRGB(230, 230, 230)
    TextBox.TextSize = 10
    TextBox.Font = Enum.Font.Gotham
    TextBox.TextXAlignment = Enum.TextXAlignment.Left
    TextBox.ClearTextOnFocus = false
    
    TextBox.FocusLost:Connect(function()
        if TextBox.Text == "" then TextBox.Text = slotDados.nome else slotDados.nome = TextBox.Text end
        salvarListaEmArquivo()
    end)

    local BtnEngrenagem = Instance.new("TextButton", ItemFrame)
    BtnEngrenagem.Size = UDim2.new(0, 22, 0, 22)
    BtnEngrenagem.Position = UDim2.new(1, -70, 0.5, -11)
    BtnEngrenagem.BackgroundColor3 = Color3.fromRGB(34, 34, 44)
    BtnEngrenagem.Text = "⚙"
    BtnEngrenagem.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnEngrenagem.TextSize = 10
    Instance.new("UICorner", BtnEngrenagem).CornerRadius = UDim.new(0, 4)

    local BtnVerRota = Instance.new("TextButton", ItemFrame)
    BtnVerRota.Size = UDim2.new(0, 22, 0, 22)
    BtnVerRota.Position = UDim2.new(1, -46, 0.5, -11)
    BtnVerRota.BackgroundColor3 = Color3.fromRGB(34, 34, 44)
    BtnVerRota.Text = "👁️"
    BtnVerRota.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnVerRota.TextSize = 9
    Instance.new("UICorner", BtnVerRota).CornerRadius = UDim.new(0, 4)

    local BtnPlayPause = Instance.new("TextButton", ItemFrame)
    BtnPlayPause.Size = UDim2.new(0, 22, 0, 22)
    BtnPlayPause.Position = UDim2.new(1, -22, 0.5, -11)
    BtnPlayPause.BackgroundColor3 = Color3.fromRGB(34, 34, 44)
    BtnPlayPause.Text = "▶"
    BtnPlayPause.TextColor3 = Color3.fromRGB(255, 255, 255)
    BtnPlayPause.TextSize = 10
    Instance.new("UICorner", BtnPlayPause).CornerRadius = UDim.new(0, 4)
    
    slotDados.botaoPlay = BtnPlayPause

    BtnPlayPause.MouseButton1Click:Connect(function() alternarPlaySlot(slotDados) end)

    local mostrandoLinha = false
    BtnVerRota.MouseButton1Click:Connect(function()
        mostrandoLinha = not mostrandoLinha
        if mostrandoLinha then
            BtnVerRota.BackgroundColor3 = Color3.fromRGB(130, 80, 240)
            desenharRota3D(slotDados, Color3.fromRGB(140, 90, 255))
        else
            BtnVerRota.BackgroundColor3 = Color3.fromRGB(34, 34, 44)
            removerLinhaDoSlot(slotDados)
        end
    end)

    BtnEngrenagem.MouseButton1Click:Connect(function()
        slotSelecionadoPopup = {dados = slotDados, frameUI = ItemFrame}
        PopupTitle.Text = 'Config: "' .. slotDados.nome .. '"'
        BtnKeybind.Text = "Atalho: " .. (slotDados.keybind and slotDados.keybind.Name or "Nenhum")
        BtnLoopCheck.Text = "Loop: " .. (slotDados.loopAtivo and "ATIVADO ✅" or "DESATIVADO ❌")
        PopupFrame.Visible = true
    end)
end

-- CARREGAR DADOS SALVOS
task.spawn(function()
    if readfile and isfile and HttpService and isfile(NOME_PASTA .. "/lista_saves.txt") then
        local sucesso, conteudo = pcall(function() return readfile(NOME_PASTA .. "/lista_saves.txt") end)
        if sucesso and conteudo and conteudo ~= "" then
            local sucessoJson, listaCarregada = pcall(function() return HttpService:JSONDecode(conteudo) end)
            if sucessoJson and type(listaCarregada) == "table" then
                for _, slotInfo in ipairs(listaCarregada) do
                    local kb = nil
                    if slotInfo.keybindName then pcall(function() kb = Enum.KeyCode[slotInfo.keybindName] end) end
                    local slotObj = {
                        id = slotInfo.id,
                        nome = slotInfo.nome,
                        dados = slotInfo.dados,
                        posicaoStart = slotInfo.posicaoStart,
                        tempoTotal = slotInfo.tempoTotal,
                        keybind = kb,
                        loopAtivo = slotInfo.loopAtivo or false,
                        botaoPlay = nil
                    }
                    if slotObj.id >= proximoIdSlot then proximoIdSlot = slotObj.id + 1 end
                    table.insert(listaSalvados, slotObj)
                    criarItemLista(slotObj)
                end
            end
        end
    end
end)

-- EVENTOS DOS BOTÕES PRINCIPAIS
BtnGravar.MouseButton1Click:Connect(function()
    if reproduzindo then 
        reproduzindo = false 
        if slotAtivo then slotAtivo.botaoPlay.Text = "▶" end 
        slotAtivo = nil 
    end
    
    if not gravando then
        gravacaoTemporaria = {}
        posicaoInicial = rootPart.Position
        tempoDecorrido = 0
        gravando = true

        if slotUltimaTemp then removerLinhaDoSlot(slotUltimaTemp) end
        exibindoUltimaLinha = false
        BtnVerUltimaRota.BackgroundColor3 = Color3.fromRGB(36, 36, 48)
        
        if gravarEmSlow then
            aplicarFisicaSlow(true)
        end
        
        BtnGravar.BackgroundColor3 = Color3.fromRGB(210, 50, 50)
        BtnGravar.Text = "⏹ Parar Gravação"
        StatusBadge.Text = "REC"
        StatusBadge.TextColor3 = Color3.fromRGB(255, 90, 90)
    else
        gravando = false
        aplicarFisicaSlow(false)
        BtnGravar.BackgroundColor3 = Color3.fromRGB(130, 80, 240)
        BtnGravar.Text = "⏺ Gravar Nova Rota"
        StatusBadge.Text = "Neutro"
        StatusBadge.TextColor3 = Color3.fromRGB(160, 160, 170)
    end
end)

BtnReproduzir.MouseButton1Click:Connect(function()
    if #gravacaoTemporaria > 0 and posicaoInicial then
        local posTable = {posicaoInicial.X, posicaoInicial.Y, posicaoInicial.Z}
        local slotTemp = {dados = gravacaoTemporaria, posicaoStart = posTable, tempoTotal = tempoDecorrido, botaoPlay = BtnReproduzir, loopAtivo = false}
        
        if reproduzindo then
            reproduzindo = false
            BtnReproduzir.Text = "▶ Reproduzir ÚLTIMA"
            StatusBadge.Text = "Neutro"
            StatusBadge.TextColor3 = Color3.fromRGB(160, 160, 170)
        else
            if gravando then
                gravando = false
                aplicarFisicaSlow(false)
                BtnGravar.BackgroundColor3 = Color3.fromRGB(130, 80, 240)
                BtnGravar.Text = "⏺ Gravar Nova Rota"
            end
            
            tempoDecorrido = 0
            slotAtivo = slotTemp
            
            local destino = Vector3.new(posicaoInicial.X + gravacaoTemporaria[1].offX, posicaoInicial.Y + gravacaoTemporaria[1].offY, posicaoInicial.Z + gravacaoTemporaria[1].offZ)
            local targetCFrame = CFrame.new(destino) * CFrame.fromEulerAnglesYXZ(0, gravacaoTemporaria[1].rotY, 0)

            BtnReproduzir.Text = "⏳ Movendo..."
            StatusBadge.Text = "Play"
            StatusBadge.TextColor3 = Color3.fromRGB(90, 255, 90)

            moverAteInicio(destino, targetCFrame, function()
                reproduzindo = true
                BtnReproduzir.Text = "⏸ Parar Reprodução"
            end)
        end
    end
end)

BtnSalvar.MouseButton1Click:Connect(function()
    if #gravacaoTemporaria > 0 and posicaoInicial then
        local dadosClonados = {}
        for i, v in ipairs(gravacaoTemporaria) do dadosClonados[i] = v end
        local novoSlot = {
            id = proximoIdSlot,
            nome = "Rota " .. proximoIdSlot,
            dados = dadosClonados,
            posicaoStart = {posicaoInicial.X, posicaoInicial.Y, posicaoInicial.Z},
            tempoTotal = tempoDecorrido,
            keybind = nil,
            loopAtivo = false,
            botaoPlay = nil
        }
        proximoIdSlot = proximoIdSlot + 1
        table.insert(listaSalvados, novoSlot)
        criarItemLista(novoSlot)
        salvarListaEmArquivo()
    end
end)

