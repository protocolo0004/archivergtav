--------------------------------------------------------------------
-- SISTEMA ASSÍNCRONO DE DESENHO DA ROTA 3D
--------------------------------------------------------------------
local function removerLinhaDoSlot(slotDados)
    if slotDados.pastaVisualizer then
        slotDados.pastaVisualizer:Destroy()
        slotDados.pastaVisualizer = nil
    end
end

local function desenharRota3D(slotDados, corLinha)
    removerLinhaDoSlot(slotDados)
    if not slotDados.dados or #slotDados.dados < 2 then return end

    task.defer(function()
        local pastaSlot = Instance.new("Folder", pastaLinhas)
        pastaSlot.Name = "Path_" .. tostring(slotDados.id or "Temp")
        slotDados.pastaVisualizer = pastaSlot

        corLinha = corLinha or Color3.fromRGB(140, 90, 255)
        local posInicio = Vector3.new(slotDados.posicaoStart[1], slotDados.posicaoStart[2], slotDados.posicaoStart[3])

        if character then
            character.Archivable = true
            local clone = character:Clone()
            character.Archivable = false

            if clone then
                clone.Name = "StartGhost"
                for _, item in ipairs(clone:GetDescendants()) do
                    if item:IsA("BasePart") then
                        item.Anchored = true
                        item.CanCollide = false
                        item.Transparency = 0.5
                    elseif item:IsA("LocalScript") or item:IsA("Script") then
                        item:Destroy()
                    end
                end
                
                local hum = clone:FindFirstChildOfClass("Humanoid")
                if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end

                local pPrimeiro = slotDados.dados[1]
                local posStartActual = posInicio + Vector3.new(pPrimeiro.offX, pPrimeiro.offY, pPrimeiro.offZ)
                local cfStartActual = CFrame.new(posStartActual) * CFrame.fromEulerAnglesYXZ(0, pPrimeiro.rotY, 0)
                
                clone:PivotTo(cfStartActual)
                clone.Parent = pastaSlot
            end
        end

        local totalPontos = #slotDados.dados
        local maxSegumentos = 40
        local passo = math.max(1, math.floor(totalPontos / maxSegumentos))

        local pontos = {}
        for i = 1, totalPontos, passo do
            local p = slotDados.dados[i]
            table.insert(pontos, posInicio + Vector3.new(p.offX, p.offY - 2.8, p.offZ))
        end
        local pUltimo = slotDados.dados[totalPontos]
        table.insert(pontos, posInicio + Vector3.new(pUltimo.offX, pUltimo.offY - 2.8, pUltimo.offZ))

        for i = 1, #pontos - 1 do
            local pA = pontos[i]
            local pB = pontos[i + 1]

            local partA = Instance.new("Part")
            partA.Size = Vector3.new(0.05, 0.05, 0.05)
            partA.Position = pA
            partA.Anchored = true
            partA.CanCollide = false
            partA.Transparency = 1
            partA.Parent = pastaSlot

            local partB = Instance.new("Part")
            partB.Size = Vector3.new(0.05, 0.05, 0.05)
            partB.Position = pB
            partB.Anchored = true
            partB.CanCollide = false
            partB.Transparency = 1
            partB.Parent = pastaSlot

            local attA = Instance.new("Attachment", partA)
            local attB = Instance.new("Attachment", partB)

            local beam = Instance.new("Beam", pastaSlot)
            beam.Attachment0 = attA
            beam.Attachment1 = attB
            beam.Color = ColorSequence.new(corLinha)
            beam.Width0 = 0.2
            beam.Width1 = 0.2
            beam.FaceCamera = true
            beam.LightEmission = 0.8
            beam.Transparency = NumberSequence.new(0.2)
        end
    end)
end

--------------------------------------------------------------------
-- SISTEMA DE FÍSICA DE SLOW MOTION E PULO CONTROLADO
--------------------------------------------------------------------
local function atualizarForcaVectorForce(ativo)
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local vf = root:FindFirstChild("GravidadeVectorForce")
    
    if not ativo or not gravando or not gravarEmSlow then
        if vf then vf.Enabled = false end
        return
    end

    if not vf then
        local attachment = root:FindFirstChild("RootRigAttachment") or Instance.new("Attachment", root)
        vf = Instance.new("VectorForce")
        vf.Name = "GravidadeVectorForce"
        vf.Attachment0 = attachment
        vf.RelativeTo = Enum.ActuatorRelativeTo.World
        vf.ApplyAtCenterOfMass = true
        vf.Parent = root
    end

    local massaTotal = 0
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            massaTotal = massaTotal + part:GetMass()
        end
    end

    local gravidadeNormal = workspace.Gravity
    local gravidadeDesejada = gravidadeNormal * (fatorSlow * fatorSlow)
    local diferencaGravidade = gravidadeNormal - gravidadeDesejada
    
    vf.Force = Vector3.new(0, massaTotal * diferencaGravidade, 0)

    local estado = humanoid:GetState()
    if estado == Enum.HumanoidStateType.Freefall or estado == Enum.HumanoidStateType.Jumping then
        vf.Enabled = true
    else
        vf.Enabled = false
    end
end

local function aplicarFisicaSlow(ativo)
    if conexaoSlowDinamic then conexaoSlowDinamic:Disconnect() conexaoSlowDinamic = nil end
    if conexaoWalkSpeedWatch then conexaoWalkSpeedWatch:Disconnect() conexaoWalkSpeedWatch = nil end
    if conexaoJumpState then conexaoJumpState:Disconnect() conexaoJumpState = nil end

    if ativo then
        if humanoid then
            velocidadeSemSlow = humanoid.WalkSpeed
            jumpPowerOriginal = humanoid.JumpPower
            jumpHeightOriginal = humanoid.JumpHeight

            if humanoid.UseJumpPower then
                humanoid.JumpPower = jumpPowerOriginal * fatorSlow
            else
                humanoid.JumpHeight = jumpHeightOriginal * (fatorSlow * fatorSlow)
            end
            
            conexaoWalkSpeedWatch = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                local velAtual = humanoid.WalkSpeed
                if math.abs(velAtual - (velocidadeSemSlow * fatorSlow)) > 0.1 then
                    velocidadeSemSlow = velAtual
                end
            end)

            conexaoJumpState = humanoid.StateChanged:Connect(function(_, novoEstado)
                if novoEstado == Enum.HumanoidStateType.Jumping and rootPart then
                    task.defer(function()
                        if rootPart then
                            local vel = rootPart.AssemblyLinearVelocity
                            rootPart.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y * fatorSlow, vel.Z)
                        end
                    end)
                end
            end)
        end

        conexaoSlowDinamic = RunService.PreSimulation:Connect(function()
            if humanoid and gravando then
                humanoid.WalkSpeed = velocidadeSemSlow * fatorSlow
                atualizarForcaVectorForce(true)
            end
        end)

        pcall(function()
            local animator = humanoid:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    track:AdjustSpeed(fatorSlow)
                end
            end
        end)
    else
        atualizarForcaVectorForce(false)

        if humanoid then
            humanoid.WalkSpeed = velocidadeSemSlow
            humanoid.JumpPower = jumpPowerOriginal
            humanoid.JumpHeight = jumpHeightOriginal
        end

        pcall(function()
            local animator = humanoid:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    track:AdjustSpeed(1.0)
                end
            end
        end)
    end
end

-- MOVER ATÉ O INÍCIO
local function moverAteInicio(destino, targetCFrame, callback)
    if not rootPart or not humanoid or not character then return end
    local distancia = (rootPart.Position - destino).Magnitude

    if distancia > 50 or distancia <= 1.5 then
        rootPart.AssemblyLinearVelocity = Vector3.zero
        character:PivotTo(targetCFrame)
        if callback then callback() end
        return
    end

    rootPart.AssemblyLinearVelocity = Vector3.zero
    humanoid:MoveTo(destino)

    local conexao
    local finalizado = false

    local function finalizar()
        if finalizado then return end
        finalizado = true
        if conexao then conexao:Disconnect() end
        
        humanoid.AutoRotate = false
        local tween = TweenService:Create(
            rootPart,
            TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {CFrame = targetCFrame}
        )
        tween:Play()
        tween.Completed:Wait()
        humanoid.AutoRotate = true

        if callback then callback() end
    end

    conexao = humanoid.MoveToFinished:Connect(function()
        finalizar()
    end)

    task.delay(3.0, function()
        if not finalizado then
            finalizar()
        end
    end)
end

-- LOOP PRINCIPAL DE FÍSICA E ROTAÇÃO
RunService.PostSimulation:Connect(function(deltaTime)
    if not rootPart or not humanoid then return end

    if gravando then
        local deltaReal = gravarEmSlow and (deltaTime * fatorSlow) or deltaTime
        tempoDecorrido = tempoDecorrido + deltaReal
        
        local _, y, _ = rootPart.CFrame:ToEulerAnglesYXZ()
        local multVel = gravarEmSlow and (1 / fatorSlow) or 1.0
        
        table.insert(gravacaoTemporaria, {
            tempo = tempoDecorrido,
            velX = rootPart.AssemblyLinearVelocity.X * multVel,
            velY = rootPart.AssemblyLinearVelocity.Y * multVel,
            velZ = rootPart.AssemblyLinearVelocity.Z * multVel,
            estado = humanoid:GetState().Name,
            rotY = y,
            offX = rootPart.Position.X - posicaoInicial.X,
            offY = rootPart.Position.Y - posicaoInicial.Y,
            offZ = rootPart.Position.Z - posicaoInicial.Z
        })
        
    elseif reproduzindo and slotAtivo then
        tempoDecorrido = tempoDecorrido + deltaTime
        local historico = slotAtivo.dados
        
        local dadosAlvo = nil
        for i = #historico, 1, -1 do
            if historico[i].tempo <= tempoDecorrido then
                dadosAlvo = historico[i]
                break
            end
        end
        
        if tempoDecorrido >= slotAtivo.tempoTotal or not dadosAlvo then
            if slotAtivo.loopAtivo then
                tempoDecorrido = 0
                rootPart.AssemblyLinearVelocity = Vector3.zero
                local posX = slotAtivo.posicaoStart[1] + historico[1].offX
                local posY = slotAtivo.posicaoStart[2] + historico[1].offY
                local posZ = slotAtivo.posicaoStart[3] + historico[1].offZ
                character:PivotTo(CFrame.new(posX, posY, posZ) * CFrame.fromEulerAnglesYXZ(0, historico[1].rotY, 0))
            else
                reproduzindo = false
                if slotAtivo.botaoPlay then slotAtivo.botaoPlay.Text = "▶" end
                slotAtivo = nil
                StatusBadge.Text = "Neutro"
                StatusBadge.TextColor3 = Color3.fromRGB(160, 160, 170)
            end
        else
            local posX = slotAtivo.posicaoStart[1] + dadosAlvo.offX
            local posY = slotAtivo.posicaoStart[2] + dadosAlvo.offY
            local posZ = slotAtivo.posicaoStart[3] + dadosAlvo.offZ
            
            local posAlvo = Vector3.new(posX, posY, posZ)
            local cframeRotAlvo = CFrame.fromEulerAnglesYXZ(0, dadosAlvo.rotY, 0)
            local targetCFrame = CFrame.new(posAlvo) * cframeRotAlvo

            local capsAtivo = UserInputService:IsKeyDown(Enum.KeyCode.CapsLock) or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
            
            if capsAtivo then
                rootPart.CFrame = targetCFrame
            else
                local rotSuave = rootPart.CFrame.Rotation:Lerp(cframeRotAlvo, math.clamp(deltaTime * 18, 0.15, 1.0))
                rootPart.CFrame = CFrame.new(posAlvo) * rotSuave
            end
            
            rootPart.AssemblyLinearVelocity = Vector3.new(dadosAlvo.velX, dadosAlvo.velY, dadosAlvo.velZ)
            
            pcall(function()
                if Enum.HumanoidStateType[dadosAlvo.estado] then
                    humanoid:ChangeState(Enum.HumanoidStateType[dadosAlvo.estado])
                end
            end)
        end
    end
end)

-- ALTERNAR PLAY / PAUSE
local function alternarPlaySlot(slotDados)
    if reproduzindo and slotAtivo == slotDados then
        reproduzindo = false
        slotDados.botaoPlay.Text = "▶"
        slotAtivo = nil
        StatusBadge.Text = "Neutro"
        StatusBadge.TextColor3 = Color3.fromRGB(160, 160, 170)
    else
        if reproduzindo and slotAtivo then slotAtivo.botaoPlay.Text = "▶" end
        
        if gravando then
            gravando = false
            aplicarFisicaSlow(false)
        end
        
        tempoDecorrido = 0
        slotAtivo = slotDados

        local inicio = Vector3.new(slotDados.posicaoStart[1], slotDados.posicaoStart[2], slotDados.posicaoStart[3])
        local destino = inicio + Vector3.new(slotDados.dados[1].offX, slotDados.dados[1].offY, slotDados.dados[1].offZ)
        local targetCFrame = CFrame.new(destino) * CFrame.fromEulerAnglesYXZ(0, slotDados.dados[1].rotY, 0)

        slotDados.botaoPlay.Text = "⏳"

        moverAteInicio(destino, targetCFrame, function()
            reproduzindo = true
            slotDados.botaoPlay.Text = "⏸"
            StatusBadge.Text = "Play"
            StatusBadge.TextColor3 = Color3.fromRGB(90, 255, 90)
        end)
    end
end

-- SALVAMENTO
local function salvarListaEmArquivo()
    task.spawn(function()
        if writefile and HttpService then
            local dadosParaSalvar = {}
            for _, slot in ipairs(listaSalvados) do
                table.insert(dadosParaSalvar, {
                    id = slot.id,
                    nome = slot.nome,
                    dados = slot.dados,
                    posicaoStart = slot.posicaoStart,
                    tempoTotal = slot.tempoTotal,
                    keybindName = slot.keybind and slot.keybind.Name or nil,
                    loopAtivo = slot.loopAtivo or false
                })
            end
            pcall(function() 
                writefile(NOME_PASTA .. "/lista_saves.txt", HttpService:JSONEncode(dadosParaSalvar)) 
            end)
        end
    end)
end

