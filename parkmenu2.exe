AutoFarmCard:AddToggle("Ativar Auto Farm", false, function(state)
    farmAtivo = state
    if farmAtivo then
        if modoSelecionado == "None" or not modoSelecionado then
            Library:Notify({ Title = "Erro", Description = "Selecione o Tipo de Coleta primeiro!", Duration = 3 })
            farmAtivo = false
            return
        end
        Library:Notify({ Title = "Farm", Description = "Iniciado: " .. modoSelecionado, Duration = 3 })
        iniciarFarmContinuo()
    else
        Library:Notify({ Title = "Farm", Description = "Farm parado.", Duration = 3 })
    end
end, { Title = "Iniciar Farm" })
