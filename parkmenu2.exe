local CombatTab = Window:CreateTab("Combate", false, false)
local CombatPage = CombatTab:CreatePage("Hitbox & Aim")

-- Variáveis da Hitbox
local hitboxEnabled = false
local hitboxSize = 2
local hitboxTransparency = 0.5
local hitboxShape = "Quadrado"
local hitboxColor = Color3.fromRGB(255, 0, 0)
local tempoAcumulado = 0

local function restaurarHitboxes()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
                hrp.Shape = Enum.PartType.Block
                hrp.CanTouch = true
            end
        end
    end
end

RunService.Heartbeat:Connect(function(deltaTime)
    if not hitboxEnabled then return end
    tempoAcumulado = tempoAcumulado + deltaTime
    if tempoAcumulado < 0.05 then return end
    tempoAcumulado = 0
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CanTouch = true
                hrp.CanQuery = true 
                hrp.CanCollide = false 
                hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                hrp.Transparency = hitboxTransparency
                hrp.Color = hitboxColor
                hrp.Material = Enum.Material.ForceField
                if hitboxShape == "Bola" then
                    hrp.Shape = Enum.PartType.Ball
                else
                    hrp.Shape = Enum.PartType.Block
                end
            end
        end
    end
end)

-- UI do Combate
local HitboxSec = CombatPage:CreateSection("Hitbox Modificador")
HitboxSec:AddToggle("Ativar Hitbox", false, function(state)
    hitboxEnabled = state
    if not state then
        restaurarHitboxes()
    end
end, { Title = "Habilitar Expansão" })

HitboxSec:AddSlider("Tamanho", 2, 15, 2, function(value)
    hitboxSize = value
end, { Title = "Tamanho do HRP" })

HitboxSec:AddSlider("Transparência", 0, 10, 5, function(value)
    hitboxTransparency = value / 10
end, { Title = "Nível de Transparência" })

HitboxSec:AddDropdown("Formato", {"Quadrado", "Bola"}, false, function(selected)
    hitboxShape = selected
    restaurarHitboxes()
end, { Title = "Geometria da Hitbox" })

HitboxSec:AddColorPicker("Cor da Hitbox", Color3.fromRGB(255, 0, 0), function(color)
    hitboxColor = color
end, { Title = "Cor (RGB)" })

