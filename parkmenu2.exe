-- ========================================== --
-- 🧠 MOTOR LÓGICO E UI: AUTO JJS (POLICHINELOS)
-- ========================================== --
local quantidadeMaxima = 0 
local autoJJSEnabled = false
local delaySegundos = 0.53
local keyMap = { Q = Enum.KeyCode.Q, E = Enum.KeyCode.E }

local function dispararTecla(keycode)
    pcall(function()
        if not VIM then return end
        VIM:SendKeyEvent(true, keycode, false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, keycode, false, game)
    end)
end

local function cliqueVirtualFisico(button)
    if not button then return end
    pcall(function()
        firesignal(button.MouseButton1Down)
        firesignal(button.MouseButton1Click)
        firesignal(button.TouchTap)
        button:Activate()
        if VIM then
            local x = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
            local y = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2)
            VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
        end
    end)
end

local function pegarJJSAtual()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Head") then
        for _, v in ipairs(char.Head:GetChildren()) do
            if v:IsA("BillboardGui") and (v.Name:lower():find("poli") or v.Name:lower():find("jjs") or v.Name:lower():find("texto")) then
                local label = v:FindFirstChildOfClass("TextLabel")
                if label and label.Text then
                    local numStr = string.match(label.Text, "%d+")
                    if numStr then return tonumber(numStr) end
                end
            end
        end
    end
    return -1 
end

local JjsCard = Havac_Page:CreateSection("Auto JJS")

JjsCard:AddToggle("Ativar Auto JJS", false, function(state)
    autoJJSEnabled = state
    if autoJJSEnabled then
        local metaAlvo = (quantidadeMaxima > 0) and quantidadeMaxima or math.huge
        Library:Notify({Title = "Auto JJS", Description = "Iniciado. Lendo valor da cabeça!", Duration = 3})

        task.spawn(function()
            local processados = {}
            local countProc = 0
            
            while autoJJSEnabled do
                local jjsReal = pegarJJSAtual()
                
                if metaAlvo ~= math.huge and jjsReal >= metaAlvo then
                    autoJJSEnabled = false
                    Library:Notify({Title = "Concluído", Description = "Você atingiu o limite de " .. metaAlvo .. " JJS!", Duration = 4})
                    break
                end
                
                pcall(function()
                    local screen = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("Polichinelos") and LocalPlayer.PlayerGui.Polichinelos:FindFirstChild("Screen")
                    if screen and autoJJSEnabled then
                        for _, botao in ipairs(screen:GetChildren()) do
                            if botao:IsA("ImageButton") and botao.Visible and not processados[botao] then
                                local label = botao:FindFirstChildWhichIsA("TextLabel")
                                if label and label.Text and label.Text ~= "" then
                                    local textoLetra = tostring(label.Text):upper():gsub("%s+", "")
                                    processados[botao] = true
                                    countProc = countProc + 1
                                    
                                    if keyMap[textoLetra] then dispararTecla(keyMap[textoLetra]) else cliqueVirtualFisico(botao) end
                                    
                                    local remote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Polichinelos")
                                    if remote then remote:FireServer("Add", 1) end

                                    task.wait(delaySegundos)
                                    break
                                end
                            end
                        end
                    end
                end)
                
                if countProc > 15 then 
                    table.clear(processados)
                    countProc = 0 
                end
                task.wait(0.1)
            end
        end)
    else
        Library:Notify({Title = "Auto JJS", Description = "Pausado.", Duration = 3})
    end
end, { Title = "Status do JJS" })

JjsCard:AddTextbox("Quantidade Limite Exata", "Ex: 308", function(text)
    local num = tonumber(text)
    if num and num > 0 then
        quantidadeMaxima = num
        Library:Notify({Title = "Limite Exato", Description = "O robô vai parar ao chegar em " .. num, Duration = 3})
    else
        quantidadeMaxima = 0
        Library:Notify({Title = "Configuração", Description = "Modo INFINITO ativado!", Duration = 3})
    end
end, { Title = "Parar JJS quando atingir:" })

JjsCard:AddSlider("Delay", 53, 200, 53, function(val) delaySegundos = math.max(val, 53) / 100 end, { Title = "Atraso (ms)" })
-- ========================================== --
-- 🧠 MOTOR LÓGICO 3: AUTO FARM E MISSÕES (MICRO-TP UNDERGROUND)
-- ========================================== --
local farmAtivo = false
local modoSelecionado = "None"
local farmTrofeuRunning = false
local autoMissaoAtivo = false
local posicaoInicialMissao = nil
local conexaoCamera = nil

-- Profundidade enquanto aguarda/se aproxima (número negativo = debaixo do chão)
local OFFSET_Y = -6 

local function configurarPrompt(prompt)
    if prompt:IsA("ProximityPrompt") then
        if prompt.HoldDuration > 0 then prompt.HoldDuration = 0 end
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 30
    end
end

local function zerarVelocidade(hrp)
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
end

-- Função central do Micro-Teleporte:
-- Fica embaixo -> sobe por milissegundos -> coleta -> volta pra baixo
local function executarColetaMicroTP(hrp, alvoPos, prompt)
    if not prompt or not prompt.Enabled then return false end
    
    configurarPrompt(prompt)
    zerarVelocidade(hrp)
    
    -- 1. Posiciona debaixo do chão próximo ao item
    hrp.CFrame = CFrame.new(alvoPos + Vector3.new(0, OFFSET_Y, 0))
    task.wait(0.05)
    
    -- 2. Micro-TP instantâneo para cima da superfície
    hrp.CFrame = CFrame.new(alvoPos + Vector3.new(0, 2, 0))
    task.wait(0.04)
    
    -- 3. Aciona a coleta no servidor
    if fireproximityprompt and prompt.Enabled then
        fireproximityprompt(prompt)
    end
    
    task.wait(0.04)
    
    -- 4. Retorna para debaixo do chão
    hrp.CFrame = CFrame.new(alvoPos + Vector3.new(0, OFFSET_Y, 0))
    zerarVelocidade(hrp)
    return true
end

local function travarCameraCima()
    if conexaoCamera then conexaoCamera:Disconnect() end
    Camera.CameraType = Enum.CameraType.Scriptable
    conexaoCamera = RunService.RenderStepped:Connect(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then Camera.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 15, 0), hrp.Position) end
    end)
end

local function restaurarCamera()
    if conexaoCamera then conexaoCamera:Disconnect() end
    conexaoCamera = nil
    Camera.CameraType = Enum.CameraType.Custom
end

local function temFerramenta(nome)
    local char = LocalPlayer.Character
    local bp = LocalPlayer.Backpack
    if char and bp then
        if char:FindFirstChild(nome) then return true end
        local f = bp:FindFirstChild(nome)
        if f then
            f.Parent = char
            task.wait(0.1)
            return true
        end
    end
    return false
end

local function pegarFoice()
    if temFerramenta("Foice") then return true end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        local posFoice = Vector3.new(-355, 3, -625)
        hrp.CFrame = CFrame.new(posFoice + Vector3.new(0, 2, 0))
        task.wait(0.5)
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local partePai = obj.Parent
                if partePai and partePai:IsA("BasePart") then
                    if (partePai.Position - posFoice).Magnitude < 10 then
                        configurarPrompt(obj)
                        if fireproximityprompt then fireproximityprompt(obj) end
                        task.wait(0.5)
                        break
                    end
                end
            end
        end
    end
    return temFerramenta("Foice")
end

local function obterTrofeusColetaveis()
    local lista = {}
    pcall(function()
        local pasta = workspace:FindFirstChild("Map") and workspace.Map.Sistemas:FindFirstChild("Miss\195\163o") and workspace.Map.Sistemas["Miss\195\163o"]:FindFirstChild("Trof\195\169us")
        if pasta then
            for i = 1, 10 do
                local t = pasta:FindFirstChild("Trof\195\169u" .. i) or pasta:FindFirstChild("Trofeu" .. i)
                if t then
                    local prompt = t:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and prompt.Enabled then table.insert(lista, t) end
                end
            end
        end
    end)
    return lista
end

local function iniciarAutoMissao()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then posicaoInicialMissao = hrp.CFrame end
    travarCameraCima()
    
    task.spawn(function()
        while autoMissaoAtivo do
            local mData = LocalPlayer:FindFirstChild("Miss\195\181esData") or LocalPlayer:FindFirstChild("MissoesData")
            if not mData then break end
            
            local mAtual = mData:FindFirstChild("Miss\195\163oAtual")
            if not mAtual then break end
            
            local nomeMissao = string.lower(mAtual.Value)
            local vTrofeu = mData:FindFirstChild("Trof\195\169us") and mData["Trof\195\169us"].Value or 0
            local vGrama = mData:FindFirstChild("GramasCortadas") and mData.GramasCortadas.Value or 0
            local vLixo = mData:FindFirstChild("LixosRecolhidos") and mData.LixosRecolhidos.Value or 0
            
            local metaGrama, metaLixo, metaTrofeu = 150, 150, 10
            if string.find(nomeMissao, "pra\195\167a") then metaGrama = 30; metaLixo = 15; metaTrofeu = 0
            elseif string.find(nomeMissao, "diretor") then metaGrama = 100; metaLixo = 40; metaTrofeu = 5 end
            
            local executouAcao = false
            local charAtual = LocalPlayer.Character
            local hrpAtual = charAtual and charAtual:FindFirstChild("HumanoidRootPart")
            
            if hrpAtual then
                if metaTrofeu > 0 and vTrofeu < metaTrofeu then
                    executouAcao = true
                    local listaTrofeus = obterTrofeusColetaveis()
                    if #listaTrofeus > 0 then
                        local t = listaTrofeus[1]
                        local prompt = t:FindFirstChildWhichIsA("ProximityPrompt", true)
                        executarColetaMicroTP(hrpAtual, t.Position, prompt)
                    end
                elseif metaGrama > 0 and vGrama < metaGrama then
                    executouAcao = true
                    pegarFoice()
                    local gramasPasta = workspace:FindFirstChild("Map") and workspace.Map.Sistemas.Jobs["Cortar Grama"].Gramas
                    if gramasPasta then
                        for _, grama in ipairs(gramasPasta:GetChildren()) do
                            local prompt = grama:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt and prompt.Enabled then
                                local alvo = grama:IsA("BasePart") and grama or grama:FindFirstChildWhichIsA("BasePart")
                                if alvo and alvo.Transparency < 0.9 then
                                    executarColetaMicroTP(hrpAtual, alvo.Position, prompt)
                                    break
                                end
                            end
                        end
                    end
                end
            end
            if not executouAcao then break end
            task.wait(0.1)
        end
        autoMissaoAtivo = false
        restaurarCamera()
        if posicaoInicialMissao and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = posicaoInicialMissao
        end
    end)
end

local function iniciarColetaTrofeus()
    farmTrofeuRunning = true
    task.spawn(function()
        local validos = obterTrofeusColetaveis()
        for _, trofeu in ipairs(validos) do
            local prompt = trofeu:FindFirstChildWhichIsA("ProximityPrompt", true)
            local alvo = trofeu:IsA("BasePart") and trofeu or trofeu:FindFirstChildWhichIsA("BasePart")
            local char = LocalPlayer.Character
            if prompt and prompt.Enabled and alvo and char and char:FindFirstChild("HumanoidRootPart") then
                executarColetaMicroTP(char.HumanoidRootPart, alvo.Position, prompt)
                task.wait(0.2)
            end
        end
        farmTrofeuRunning = false
    end)
end

local function farmarGrama(hrp)
    if not pegarFoice() then return false end
    local gramasPasta = workspace:FindFirstChild("Map") and workspace.Map.Sistemas.Jobs["Cortar Grama"].Gramas
    if gramasPasta then
        for _, grama in ipairs(gramasPasta:GetChildren()) do
            local prompt = grama:FindFirstChildWhichIsA("ProximityPrompt", true)
            local alvo = grama:IsA("BasePart") and grama or grama:FindFirstChildWhichIsA("BasePart")
            
            if alvo and alvo.Transparency < 0.9 and prompt and prompt.Enabled then
                return executarColetaMicroTP(hrp, alvo.Position, prompt)
            end
        end
    end
    return false
end

local function farmarLixo(hrp, char)
    local jobLixo = workspace:FindFirstChild("Map") and workspace.Map.Sistemas.Jobs["Recolher Lixo"]
    local lixoPasta = jobLixo and jobLixo:FindFirstChild("Lixos")
    local lixeirasPasta = jobLixo and jobLixo:FindFirstChild("Lixeiras")
    
    local temLixoInventario = (char:FindFirstChild("Lixo") or LocalPlayer.Backpack:FindFirstChild("Lixo"))
    
    if temLixoInventario and lixeirasPasta then
        local lixeiraAlvo = lixeirasPasta:FindFirstChildWhichIsA("BasePart", true)
        if lixeiraAlvo then
            temFerramenta("Lixo")
            local prompt = lixeiraAlvo:FindFirstChildWhichIsA("ProximityPrompt", true)
            return executarColetaMicroTP(hrp, lixeiraAlvo.Position, prompt)
        end
    elseif lixoPasta then
        for _, lixo in ipairs(lixoPasta:GetChildren()) do
            if lixo.Name == "Lixo" then
                local prompt = lixo:FindFirstChildWhichIsA("ProximityPrompt", true)
                local alvo = lixo:IsA("BasePart") and lixo or lixo:FindFirstChildWhichIsA("BasePart")
                
                if alvo and prompt and prompt.Enabled then
                    return executarColetaMicroTP(hrp, alvo.Position, prompt)
                end
            end
        end
    end
    return false
end

local function iniciarFarmContinuo()
    task.spawn(function()
        local turnoAmbos = true 
        
        while farmAtivo do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then task.wait(0.5) continue end

            if modoSelecionado == "Coletar Grama" then
                farmarGrama(hrp)
                task.wait(0.3)
                
            elseif modoSelecionado == "Coletar Lixo" then
                farmarLixo(hrp, char)
                task.wait(0.3)
                
            elseif modoSelecionado == "Ambos (Mesclado)" then
                if turnoAmbos then
                    farmarGrama(hrp)
                else
                    farmarLixo(hrp, char)
                end
                turnoAmbos = not turnoAmbos 
                task.wait(0.15) 
            end
        end
    end)
end

