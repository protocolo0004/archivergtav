-- ========================================== --
-- 🛑 FUNÇÕES DE CAMINHADA E PARADA
-- ========================================== --
local function ForcarCaminhada(posAlvoExata, targetCF)
    local distancia = (rootPart.Position - posAlvoExata).Magnitude
    if distancia > 1.5 then
        humanoid:MoveTo(posAlvoExata)
        local chegou = false
        local conexao
        conexao = humanoid.MoveToFinished:Connect(function()
            chegou = true
            if conexao then conexao:Disconnect() end
        end)
        local inicioEspera = os.clock()
        local tempoMax = (distancia / 16) + 3 
        while not chegou and (os.clock() - inicioEspera < tempoMax) do
            if (rootPart.Position - posAlvoExata).Magnitude <= 1.5 then
                chegou = true
                break
            end
            task.wait()
        end
        if conexao and conexao.Connected then conexao:Disconnect() end

        humanoid.AutoRotate = false
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        TweenService:Create(rootPart, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = targetCF}):Play()
        task.wait(0.12)
        humanoid.AutoRotate = true
    else
        rootPart.CFrame = targetCF
        task.wait(0.02)
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end
end

local function pararReproducao()
    reproduzindo = false
    slotAtivo = nil
    
    if animTrackAtual then
        animTrackAtual:Stop(0.2)
        animTrackAtual = nil
        idAnimTocando = nil
    end
    
    if humanoid then
        humanoid.WalkSpeed = 16
        rootPart.AssemblyLinearVelocity = Vector3.zero
    end
    
    if character then
        local animateScript = character:FindFirstChild("Animate")
        if animateScript then animateScript.Disabled = false end
    end
    
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Landed)
    end
end

local function limparDummies()
    if type(dummiesAtivos) == "table" then
        for _, obj in ipairs(dummiesAtivos) do
            if obj.conexao then obj.conexao:Disconnect() end
            if obj.dummy and typeof(obj.dummy) == "Instance" then obj.dummy:Destroy() end
        end
        table.clear(dummiesAtivos)
    end
end

-- ========================================== --
-- 🔄 LOOP PRINCIPAL DE REPRODUÇÃO (POST-SIMULATION)
-- ========================================== --
RunService.PostSimulation:Connect(function(deltaTime)
    if reproduzindo and slotAtivo and rootPart and humanoid then
        tempoDecorrido = tempoDecorrido + deltaTime
        local historico = slotAtivo.dados
        local dadosAlvo = historico[1] 
        
        for i = #historico, 1, -1 do
            if historico[i].tempo <= tempoDecorrido then 
                dadosAlvo = historico[i] 
                break 
            end
        end
        
        local tempoFinal = slotAtivo.tempoTotal or historico[#historico].tempo
        
        if tempoDecorrido >= tempoFinal then
            pararReproducao()
            Library:Notify({Title = "Parkour", Description = "Trajeto Concluído!", Duration = 3})
        else
            rootPart.AssemblyLinearVelocity = Vector3.new(dadosAlvo.velX, dadosAlvo.velY, dadosAlvo.velZ)
            rootPart.AssemblyAngularVelocity = Vector3.zero
            
            local posX = slotAtivo.posicaoStart[1] + dadosAlvo.offX
            local posY = slotAtivo.posicaoStart[2] + dadosAlvo.offY
            local posZ = slotAtivo.posicaoStart[3] + dadosAlvo.offZ
            
            rootPart.CFrame = CFrame.new(posX, posY, posZ) * CFrame.fromEulerAnglesYXZ(0, dadosAlvo.rotY, 0)
            
            pcall(function()
                if dadosAlvo.estado then
                    local stEnum = type(dadosAlvo.estado) == "string" and Enum.HumanoidStateType[dadosAlvo.estado] or (type(dadosAlvo.estado) == "number" and Enum.HumanoidStateType:GetEnumItems()[dadosAlvo.estado + 1])
                    if stEnum and humanoid:GetState() ~= stEnum then 
                        humanoid:ChangeState(stEnum) 
                    end
                end
            end)
            
            -- CROSSFADE SUAVE DE ANIMAÇÕES
            if dadosAlvo.animId and dadosAlvo.animId ~= "" then
                if idAnimTocando ~= dadosAlvo.animId then
                    idAnimTocando = dadosAlvo.animId
                    local novaTrack = cacheAnimacoes[dadosAlvo.animId]
                    if novaTrack then
                        pcall(function()
                            local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
                            if animator then
                                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                    if track ~= novaTrack then
                                        track:Stop(0.15)
                                    end
                                end
                            end
                        end)
                        
                        novaTrack.Priority = Enum.AnimationPriority.Action4
                        novaTrack:AdjustWeight(1)
                        if not novaTrack.IsPlaying then
                            novaTrack:Play(0.15)
                        end
                        animTrackAtual = novaTrack
                    end
                end
            end
        end
    end
end)

-- ========================================== --
-- 🧍 LÓGICA DE INÍCIO COM DUMMY E REPRODUÇÃO
-- ========================================== --
local function iniciarTrajetoHavac(slot)
    if not slot or not slot.dados or #slot.dados == 0 then
        Library:Notify({Title = "Erro", Description = "Sem dados na rota!", Duration = 3})
        return 
    end
    
    reproduzindo = false
    task.wait(0.05)
    
    -- Prepara o Cache de Animações
    pcall(function()
        local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
        if animator then
            for _, frame in ipairs(slot.dados) do
                if frame.animId and frame.animId ~= "" and not cacheAnimacoes[frame.animId] then
                    local novaAnim = Instance.new("Animation")
                    novaAnim.AnimationId = frame.animId
                    cacheAnimacoes[frame.animId] = animator:LoadAnimation(novaAnim)
                end
            end
        end
    end)

    -- Remove Animate padrão para evitar travamentos
    local animateScript = character:FindFirstChild("Animate")
    if animateScript then animateScript:Destroy() end

    local pStart = slot.posicaoStart or {rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z}
    local pPrimeiro = slot.dados[1]
    local posAlvoExata = Vector3.new(pStart[1] + pPrimeiro.offX, pStart[2] + pPrimeiro.offY, pStart[3] + pPrimeiro.offZ)
    local targetCF = CFrame.new(posAlvoExata) * CFrame.fromEulerAnglesYXZ(0, pPrimeiro.rotY, 0)
    local dist = (rootPart.Position - posAlvoExata).Magnitude

    if animTrackAtual then
        animTrackAtual:Stop(0.2)
        animTrackAtual = nil
        idAnimTocando = nil
    end

    if configSecurity then
        -- MODINHO DIRETO: Define o slot e teleporta/anda direto
        slotAtivo = slot
        tempoDecorrido = 0
        idAnimTocando = nil
        
        local velAtual = humanoid.WalkSpeed
        humanoid.WalkSpeed = 16
        if dist > 1.2 and dist < 35 then
            local moveAnim = Instance.new("Animation")
            moveAnim.AnimationId = (velAtual >= 16) and "rbxassetid://507766388" or "rbxassetid://180436148"
            local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
            local moveTrack = animator:LoadAnimation(moveAnim)
            moveTrack:Play()

            humanoid:MoveTo(posAlvoExata - Vector3.new(0, (humanoid and humanoid.HipHeight) and (humanoid.HipHeight + (rootPart.Size.Y / 2)) or 3.0, 0))
            local t0 = os.clock()
            while (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(posAlvoExata.X, 0, posAlvoExata.Z)).Magnitude > 1.2 and (os.clock() - t0) < 2.5 do 
                task.wait() 
            end
            if moveTrack then moveTrack:Stop() end
            
            humanoid:MoveTo(rootPart.Position)
            rootPart.AssemblyLinearVelocity, rootPart.AssemblyAngularVelocity, humanoid.AutoRotate = Vector3.zero, Vector3.zero
            TweenService:Create(rootPart, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = targetCF}):Play()
            task.wait(0.2)
            humanoid.AutoRotate = true
        else
            character:PivotTo(targetCF)
        end
        humanoid.WalkSpeed = velAtual
        
        if delayInicio > 0 then task.wait(delayInicio) end
        task.defer(function() reproduzindo = true end)
        Library:Notify({Title = "Parkour", Description = "Reproduzindo Trajeto!", Duration = 3})
    else
        -- MODO DUMMY VERDE
        Library:Notify({Title = "Parkour", Description = "Vá até o DUMMY VERDE brilhante!", Duration = 3})
        
        local dummy = nil
        pcall(function()
            character.Archivable = true
            dummy = character:Clone()
            character.Archivable = false
            
            for _, v in ipairs(dummy:GetDescendants()) do
                if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("ModuleScript") then
                    v:Destroy()
                end
            end
            
            for _, v in ipairs(dummy:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.ForceField
                    v.Color = Color3.fromRGB(0, 255, 0)
                    v.CanCollide = false
                    v.CanTouch = false
                    v.Anchored = true
                end
            end
            
            local offsetChao = Vector3.new(0, 1.5, 0) 
            local posicaoCorrigida = targetCF + offsetChao
            dummy:PivotTo(posicaoCorrigida)
            
            local parteReferencia = dummy:FindFirstChild("Head") or dummy:FindFirstChild("HumanoidRootPart")
            if parteReferencia then
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "ExclamacaoWaypoint"
                billboard.Size = UDim2.new(0, 50, 0, 50)
                billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                billboard.AlwaysOnTop = true
                billboard.Adornee = parteReferencia
                
                local textLabel = Instance.new("TextLabel")
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.Text = "!"
                textLabel.TextColor3 = Color3.fromRGB(255, 230, 0)
                textLabel.TextScaled = true
                textLabel.Font = Enum.Font.FredokaOne
                
                local uiStroke = Instance.new("UIStroke")
                uiStroke.Thickness = 3
                uiStroke.Color = Color3.fromRGB(0, 0, 0)
                uiStroke.Parent = textLabel
                
                textLabel.Parent = billboard
                billboard.Parent = dummy
            end
            
            dummy.Parent = workspace
        end)

        local conectado = nil
        local chegou = false
        
        local function iniciarCaminhadaSuave()
            if chegou then return end
            chegou = true
            
            -- Limpa todos os outros dummies criados antes de iniciar esta rota específica
            local dummyTemporario = dummy
            limparDummies() 
            
            -- APENAS AGORA define que ESTA é a rota oficial que vai ser tocada
            slotAtivo = slot
            tempoDecorrido = 0
            idAnimTocando = nil
            
            local velAtual = humanoid.WalkSpeed; humanoid.WalkSpeed = 16
            
            local moveAnim = Instance.new("Animation")
            moveAnim.AnimationId = (velAtual >= 16) and "rbxassetid://507766388" or "rbxassetid://180436148"
            local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
            local moveTrack = animator:LoadAnimation(moveAnim)
            moveTrack:Play()

            humanoid:MoveTo(posAlvoExata)
            
            local t0 = os.clock()
            while (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(posAlvoExata.X, 0, posAlvoExata.Z)).Magnitude > 1.2 and (os.clock() - t0) < 2.5 do
                task.wait()
            end
            if moveTrack then moveTrack:Stop() end
            
            humanoid:MoveTo(rootPart.Position)
            rootPart.AssemblyLinearVelocity, rootPart.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            TweenService:Create(rootPart, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = targetCF}):Play()
            task.wait(0.2)
            humanoid.AutoRotate = true
            humanoid.WalkSpeed = velAtual
            
            if delayInicio > 0 then task.wait(delayInicio) end
            task.defer(function() reproduzindo = true end)
            Library:Notify({Title = "Parkour", Description = "Reproduzindo Trajeto!", Duration = 3})
        end

        -- Monitoramento individual deste Dummy
        conectado = RunService.Heartbeat:Connect(function()
            if not character or not rootPart or reproduzindo then return end
            
            local posPlayerPlana = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
            local posAlvoPlana = Vector3.new(posAlvoExata.X, 0, posAlvoExata.Z)
            local distanciaHorizontal = (posPlayerPlana - posAlvoPlana).Magnitude
            
            -- DISTÂNCIA DIMINUÍDA PARA 1.5
            if distanciaHorizontal <= 1.5 and not chegou then
                iniciarCaminhadaSuave()
            end
        end)

        -- Armazena o dummy E a conexão na tabela para limparmos direito depois
        table.insert(dummiesAtivos, {
            dummy = dummy,
            conexao = conectado
        })
    end
end

-- ========================================== --
-- 🌐 SISTEMA DE CACHE E EXECUÇÃO RAW
-- ========================================== --
local cacheRotas = {}

task.spawn(function()
    for catName, categoria in pairs(RAW_URLS) do
        for identifier, versoes in pairs(categoria) do
            for versao, url in pairs(versoes) do
                if url and url ~= "" and url:sub(1, 4) == "http" then
                    task.spawn(function()
                        local s, r = pcall(function() return game:HttpGet(url) end)
                        if s and r and r ~= "" then
                            local sJson, dJson = pcall(function() return HttpService:JSONDecode(r) end)
                            if sJson and dJson then
                                if type(dJson) == "table" and dJson[1] and dJson[1].dados then 
                                    dJson = dJson[1] 
                                end
                                local cacheKey = catName .. "_" .. identifier .. "_" .. versao
                                cacheRotas[cacheKey] = dJson
                            end
                        end
                    end)
                end
            end
        end
    end
end)

local function executarRota(categoria, identifier, versao)
    if reproduzindo then
        pararReproducao()
        Library:Notify({Title = "Parado", Description = "Reprodução cancelada.", Duration = 3})
        return
    end

    local cacheKey = categoria .. "_" .. identifier .. "_" .. versao
    
    if cacheRotas[cacheKey] then
        Library:Notify({Title = "Sucesso", Description = "Iniciando trajeto instantaneamente!", Duration = 2})
        iniciarTrajetoHavac(cacheRotas[cacheKey])
        return
    end

    local url = ""
    if categoria == "Parkours" then
        url = RAW_URLS["Parkours"][identifier] and RAW_URLS["Parkours"][identifier][versao]
    else
        url = RAW_URLS["Torres"][identifier] and RAW_URLS["Torres"][identifier][versao]
    end

    if not url or url == "" or url:sub(1, 4) ~= "http" then
        Library:Notify({Title = "Erro", Description = "URL RAW não configurada para esta versão.", Duration = 3})
        return
    end

    Library:Notify({Title = "Carregando", Description = "Baixando dados RAW...", Duration = 3})

    task.spawn(function()
        local sucesso, resposta = pcall(function()
            return game:HttpGet(url)
        end)

        if sucesso and resposta and resposta ~= "" then
            local jsonSucesso, dadosSlot = pcall(function()
                return HttpService:JSONDecode(resposta)
            end)

            if jsonSucesso and dadosSlot then
                if type(dadosSlot) == "table" and dadosSlot[1] and dadosSlot[1].dados then
                    dadosSlot = dadosSlot[1]
                end
                cacheRotas[cacheKey] = dadosSlot 
                iniciarTrajetoHavac(dadosSlot)
            else
                Library:Notify({Title = "Erro", Description = "JSON malformatado ou inválido.", Duration = 3})
            end
        else
            Library:Notify({Title = "Erro", Description = "Falha ao conectar no RAW.", Duration = 3})
        end
    end)
end

-- ========================================== --
-- 🎨 SEÇÕES E ELEMENTOS DE PARKOUR NA UI
-- ========================================== --
local listaVersoes = {"Lento", "Rápido", "Mais Rápido", "Sem Burla"}
local velocidadesParkour = {
    ["Parkour 1"] = "Lento",
    ["Parkour 2"] = "Lento",
    ["Parkour 3"] = "Lento",
    ["Parkour 4"] = "Lento"
}

for i = 1, 4 do
