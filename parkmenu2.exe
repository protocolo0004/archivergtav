--------------------------------------------------------------------
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    rootPart = newChar:WaitForChild("HumanoidRootPart")
end)

local configSecurity = false 
local NOME_PASTA = "HVC Premium"
if isfolder and not isfolder(NOME_PASTA) then
    pcall(function() makefolder(NOME_PASTA) end)
end

-- Variáveis do TAS
local gravando, reproduzindo = false, false
local tempoDecorrido = 0
local posicaoInicial = nil
local gravacaoTemporaria = {}
local rotasSalvas = {} 
local fatorSlow, gravarEmSlow, loopAtivo, delayInicio = 1.0, false, false, 0
local mostrarVisualizer, mostrarVisualizerTemp, mostrarVisualizerSelecionada = true, true, true
local conexaoSlowDinamic, conexaoWalkSpeedWatch = nil, nil
local velocidadeSemSlow, jumpPowerOriginal, jumpHeightOriginal = 16, 50, 7.2
local nomeCustomizado = ""
local contadorAutomatico = 1
local slotAtivo = nil
local pastaLinhas = Instance.new("Folder", workspace)
pastaLinhas.Name = "PrincesinhoPathVisualizers"
local pastaVisualizerTemp, pastaVisualizerSelecionada = nil, nil
local indiceRotaAtual = 1
local listaDeRotas = {}
local rotaSelecionada = "Nenhuma"

-- Controle de Animação com Transição Suave (Crossfade)
local animTrackAtual = nil
local idAnimTocando = nil
local cacheAnimacoes = {}

--------------------------------------------------------------------
-- 🧠 FUNÇÕES LÓGICAS DO TAS (ARQUIVOS, FÍSICA E RENDERIZAÇÃO)
--------------------------------------------------------------------
local function limparNomeArquivo(nome) return string.gsub(nome, "[%s%p]", "_") end

local function salvarArquivoRota(nomeRota, tabelaDados)
    if writefile then
        pcall(function()
            tabelaDados.nomeRota = nomeRota
            local json = HttpService:JSONEncode(tabelaDados)
            writefile(NOME_PASTA .. "/" .. limparNomeArquivo(nomeRota) .. ".json", json)
        end)
    end
end

local function deletarArquivoRota(nomeRota)
    if delfile and isfile then
        pcall(function()
            local caminho = NOME_PASTA .. "/" .. limparNomeArquivo(nomeRota) .. ".json"
            if isfile(caminho) then delfile(caminho) end
        end)
    end
end

local function carregarArquivosIniciais()
    rotasSalvas = {}
    if listfiles and readfile and isfolder and isfolder(NOME_PASTA) then
        pcall(function()
            for _, arq in ipairs(listfiles(NOME_PASTA)) do
                if string.match(arq, "%.json$") then
                    local ok, conteudo = pcall(function() return readfile(arq) end)
                    if ok and conteudo then
                        local okJson, dados = pcall(function() return HttpService:JSONDecode(conteudo) end)
                        if okJson and dados and dados.dados then
                            local nomeSalvo = dados.nomeRota or string.gsub(arq, "^.*[/\\]", ""):gsub("%.json$", "")
                            rotasSalvas[nomeSalvo] = dados
                        end
                    end
                end
            end
        end)
    end
end
carregarArquivosIniciais()

local function atualizarListaNavegacao(manterNome)
    listaDeRotas = {}
    for nome, _ in pairs(rotasSalvas) do table.insert(listaDeRotas, nome) end
    table.sort(listaDeRotas)
    if #listaDeRotas == 0 then table.insert(listaDeRotas, "Nenhuma") end
    
    if manterNome and rotasSalvas[manterNome] then
        for idx, nome in ipairs(listaDeRotas) do
            if nome == manterNome then indiceRotaAtual = idx break end
        end
    else
        if indiceRotaAtual > #listaDeRotas then indiceRotaAtual = #listaDeRotas elseif indiceRotaAtual < 1 then indiceRotaAtual = 1 end
    end
    rotaSelecionada = listaDeRotas[indiceRotaAtual] or "Nenhuma"
end

local function limparVisualizer(pasta) if pasta then pasta:Destroy() end end

local function desenharRota3D(slotDados, corLinha)
    if not slotDados or not slotDados.dados or #slotDados.dados < 2 then return nil end
    local pastaSlot = Instance.new("Folder", pastaLinhas)
    pastaSlot.Name = "PathVisualizer"
    corLinha = corLinha or Color3.fromRGB(140, 90, 255)
    local posInicio = Vector3.new(slotDados.posicaoStart[1], slotDados.posicaoStart[2], slotDados.posicaoStart[3])
    local offsetPe = (humanoid and humanoid.HipHeight) and (humanoid.HipHeight + (rootPart.Size.Y / 2)) or 3.0

    local pontosRender, ultimoPontoRender = {}, nil
    for i = 1, #slotDados.dados do
        local p = slotDados.dados[i]
        local posAtual = posInicio + Vector3.new(p.offX, p.offY - offsetPe, p.offZ)
        if not ultimoPontoRender or (ultimoPontoRender - posAtual).Magnitude >= 0.6 or i == #slotDados.dados then
            table.insert(pontosRender, posAtual)
            ultimoPontoRender = posAtual
        end
    end

    for i = 1, #pontosRender - 1 do
        local p1, p2 = pontosRender[i], pontosRender[i+1]
        local distancia = (p1 - p2).Magnitude
        if distancia > 0.05 then
            local linha = Instance.new("Part", pastaSlot)
            linha.Anchored, linha.CanCollide, linha.CanTouch, linha.CanQuery = true, false, false, false
            linha.Material, linha.Color, linha.Transparency = Enum.Material.Neon, corLinha, 0.3
            linha.Size = Vector3.new(0.15, 0.15, distancia)
            linha.CFrame = CFrame.lookAt(p1, p2) * CFrame.new(0, 0, -distancia / 2)
        end
    end
    return pastaSlot
end

local function mudarVisualizerSelecionado()
    limparVisualizer(pastaVisualizerSelecionada)
    pastaVisualizerSelecionada = nil
    if mostrarVisualizerSelecionada and rotaSelecionada ~= "Nenhuma" and rotasSalvas[rotaSelecionada] then
        pastaVisualizerSelecionada = desenharRota3D(rotasSalvas[rotaSelecionada], Color3.fromRGB(0, 255, 255))
    end
end

local function atualizarVisualizerTemp()
    limparVisualizer(pastaVisualizerTemp)
    pastaVisualizerTemp = nil
    if mostrarVisualizerTemp and #gravacaoTemporaria > 0 and posicaoInicial then
        pastaVisualizerTemp = desenharRota3D({dados = gravacaoTemporaria, posicaoStart = {posicaoInicial.X, posicaoInicial.Y, posicaoInicial.Z}}, Color3.fromRGB(255, 215, 0))
    end
end

local function atualizarForcaVectorForce(ativo)
    if not character or not rootPart then return end
    local vf = rootPart:FindFirstChild("GravidadeVectorForce")
    if not ativo or not gravando or not gravarEmSlow then
        if vf then vf.Enabled = false; vf:Destroy() end
        return
    end
    if not vf then
        local att = rootPart:FindFirstChild("RootRigAttachment") or Instance.new("Attachment", rootPart)
        vf = Instance.new("VectorForce", rootPart)
        vf.Name, vf.Attachment0, vf.RelativeTo, vf.ApplyAtCenterOfMass = "GravidadeVectorForce", att, Enum.ActuatorRelativeTo.World, true
    end
    local massaTotal, gravNormal = rootPart.AssemblyMass, workspace.Gravity
    vf.Force = Vector3.new(0, massaTotal * (gravNormal - (gravNormal * (fatorSlow * fatorSlow))), 0)
    vf.Enabled = (humanoid.FloorMaterial == Enum.Material.Air) or (humanoid:GetState() == Enum.HumanoidStateType.Freefall) or (humanoid:GetState() == Enum.HumanoidStateType.Jumping)
end

local function aplicarFisicaSlow(ativo)
    if conexaoSlowDinamic then conexaoSlowDinamic:Disconnect() conexaoSlowDinamic = nil end
    if conexaoWalkSpeedWatch then conexaoWalkSpeedWatch:Disconnect() conexaoWalkSpeedWatch = nil end

    if ativo then
        if humanoid then
            velocidadeSemSlow = humanoid.WalkSpeed
            jumpPowerOriginal = humanoid.JumpPower
            jumpHeightOriginal = humanoid.JumpHeight
            if humanoid.UseJumpPower then humanoid.JumpPower = jumpPowerOriginal * fatorSlow else humanoid.JumpHeight = jumpHeightOriginal * (fatorSlow * fatorSlow) end
            conexaoWalkSpeedWatch = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if math.abs(humanoid.WalkSpeed - (velocidadeSemSlow * fatorSlow)) > 0.1 then velocidadeSemSlow = humanoid.WalkSpeed end
            end)
        end
        conexaoSlowDinamic = RunService.PreSimulation:Connect(function()
            if humanoid and gravando then humanoid.WalkSpeed = velocidadeSemSlow * fatorSlow; atualizarForcaVectorForce(true) end
        end)
    else
        atualizarForcaVectorForce(false)
        if humanoid then
            humanoid.WalkSpeed = velocidadeSemSlow
            if humanoid.UseJumpPower then humanoid.JumpPower = jumpPowerOriginal else humanoid.JumpHeight = jumpHeightOriginal end
        end
    end
end

--------------------------------------------------------------------
-- LOOP PRINCIPAL DE GRAVAÇÃO E REPRODUÇÃO
--------------------------------------------------------------------
RunService.PostSimulation:Connect(function(deltaTime)
    if not rootPart or not humanoid then return end
    
    --------------------------------------------------------------------
    -- 1. GRAVANDO A ROTA E AS ANIMAÇÕES
    --------------------------------------------------------------------
    if gravando then
        local deltaReal = gravarEmSlow and (deltaTime * fatorSlow) or deltaTime
        tempoDecorrido = tempoDecorrido + deltaReal
        local _, y, _ = rootPart.CFrame:ToEulerAnglesYXZ()
        local multVel = gravarEmSlow and (1 / fatorSlow) or 1.0
        
        local animIdAtiva = nil
        pcall(function()
            local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if track.IsPlaying and track.Animation then
                        animIdAtiva = track.Animation.AnimationId
                        break
                    end
                end
            end
            
            if not animIdAtiva then
                local estado = humanoid:GetState()
                if estado == Enum.HumanoidStateType.Running then
                    if humanoid.MoveDirection.Magnitude > 0 then
                        animIdAtiva = "rbxassetid://507767714"
                    else
                        animIdAtiva = "rbxassetid://507766388"
                    end
                elseif estado == Enum.HumanoidStateType.Jumping or estado == Enum.HumanoidStateType.Freefall then
                    animIdAtiva = "rbxassetid://507765000"
                end
            end
        end)

        table.insert(gravacaoTemporaria, {
            tempo = tempoDecorrido, 
            velX = rootPart.AssemblyLinearVelocity.X * multVel,
            velY = rootPart.AssemblyLinearVelocity.Y * multVel, 
            velZ = rootPart.AssemblyLinearVelocity.Z * multVel,
            estado = humanoid:GetState().Name, 
            rotY = y,
            offX = rootPart.Position.X - posicaoInicial.X, 
            offY = rootPart.Position.Y - posicaoInicial.Y, 
            offZ = rootPart.Position.Z - posicaoInicial.Z,
            animId = animIdAtiva
        })
        
    --------------------------------------------------------------------
    -- 2. REPRODUZINDO A ROTA COM TRANSIÇÃO SUAVE (CROSSFADE)
    --------------------------------------------------------------------
    elseif reproduzindo and slotAtivo then
        tempoDecorrido = tempoDecorrido + deltaTime
        local historico = slotAtivo.dados
        local dadosAlvo = historico[1] 
        
        for i = #historico, 1, -1 do
            if historico[i].tempo <= tempoDecorrido then dadosAlvo = historico[i] break end
        end
        
        local tempoFinal = slotAtivo.tempoTotal or historico[#historico].tempo
        
        if tempoDecorrido >= tempoFinal then
            if loopAtivo then
                tempoDecorrido = 0
                rootPart.AssemblyLinearVelocity, rootPart.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
                local pIni = historico[1]
                character:PivotTo(CFrame.new(slotAtivo.posicaoStart[1] + pIni.offX, slotAtivo.posicaoStart[2] + pIni.offY, slotAtivo.posicaoStart[3] + pIni.offZ) * CFrame.fromEulerAnglesYXZ(0, pIni.rotY, 0))
            else
                reproduzindo, slotAtivo = false, nil
                
                if animTrackAtual then
                    animTrackAtual:Stop(0.2)
                    animTrackAtual = nil
                    idAnimTocando = nil
                end
                
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                pcall(function() Library:Notify({Title = "TAS", Description = "Reprodução Concluída!", Duration = 3}) end)
            end
        else
            rootPart.AssemblyLinearVelocity = Vector3.new(dadosAlvo.velX, dadosAlvo.velY, dadosAlvo.velZ)
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = CFrame.new(slotAtivo.posicaoStart[1] + dadosAlvo.offX, slotAtivo.posicaoStart[2] + dadosAlvo.offY, slotAtivo.posicaoStart[3] + dadosAlvo.offZ) * CFrame.fromEulerAnglesYXZ(0, dadosAlvo.rotY, 0)
            
            pcall(function()
                if dadosAlvo.estado then
                    local stEnum = Enum.HumanoidStateType[dadosAlvo.estado]
                    if stEnum and humanoid:GetState() ~= stEnum then humanoid:ChangeState(stEnum) end
                end
            end)
            
            -- CROSSFADE SUAVE: SÓ MUDA A ANIMAÇÃO QUANDO O ID REALMENTE MUDAR, COM TRANSIÇÃO FLUIDA
            if dadosAlvo.animId and dadosAlvo.animId ~= "" then
                if idAnimTocando ~= dadosAlvo.animId then
                    idAnimTocando = dadosAlvo.animId
                    local novaTrack = cacheAnimacoes[dadosAlvo.animId]
                    if novaTrack then
                        pcall(function()
                            local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
                            if animator then
                                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                    if track ~= novaTrack then
                                        track:Stop(0.15)
                                    end
                                end
                            end
                        end)
                        
                        novaTrack.Priority = Enum.AnimationPriority.Action4
                        novaTrack:AdjustWeight(1)
                        if not novaTrack.IsPlaying then
                            novaTrack:Play(0.15)
                        end
                        animTrackAtual = novaTrack
                    end
                end
            end
        end
    end
end)

local function iniciarPlayback(slot)
    if not slot or not slot.dados or #slot.dados == 0 then
        Library:Notify({Title = "Erro", Description = "Sem dados na rota!", Duration = 3}); return 
    end
    reproduzindo = false; task.wait(0.05)
    slotAtivo = slot; tempoDecorrido = 0
    idAnimTocando = nil
    cacheAnimacoes = {}
    
    pcall(function()
        local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
        if animator then
            for _, frame in ipairs(slot.dados) do
                if frame.animId and frame.animId ~= "" and not cacheAnimacoes[frame.animId] then
                    local novaAnim = Instance.new("Animation")
                    novaAnim.AnimationId = frame.animId
                    cacheAnimacoes[frame.animId] = animator:LoadAnimation(novaAnim)
                end
            end
        end
    end)

    local animateScript = character:FindFirstChild("Animate")
    if animateScript then animateScript:Destroy() end

    local pStart, pPrimeiro = slot.posicaoStart, slot.dados[1]
    local posAlvoExata = Vector3.new(pStart[1] + pPrimeiro.offX, pStart[2] + pPrimeiro.offY, pStart[3] + pPrimeiro.offZ)
    local targetCF = CFrame.new(posAlvoExata) * CFrame.fromEulerAnglesYXZ(0, pPrimeiro.rotY, 0)
    local dist = (rootPart.Position - posAlvoExata).Magnitude

    if animTrackAtual then
        animTrackAtual:Stop(0.2)
        animTrackAtual = nil
        idAnimTocando = nil
    end

    if configSecurity then
        local velAtual = humanoid.WalkSpeed; humanoid.WalkSpeed = 16
        if dist > 1.2 and dist < 35 then
            humanoid:MoveTo(posAlvoExata - Vector3.new(0, (humanoid and humanoid.HipHeight) and (humanoid.HipHeight + (rootPart.Size.Y / 2)) or 3.0, 0))
            local t0 = os.clock()
            while (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(posAlvoExata.X, 0, posAlvoExata.Z)).Magnitude > 1.2 and (os.clock() - t0) < 2.5 do task.wait() end
            humanoid:MoveTo(rootPart.Position)
            rootPart.AssemblyLinearVelocity, rootPart.AssemblyAngularVelocity, humanoid.AutoRotate = Vector3.zero, Vector3.zero
            TweenService:Create(rootPart, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = targetCF}):Play()
            task.wait(0.2); humanoid.AutoRotate = true
        else
            character:PivotTo(targetCF)
        end
        humanoid.WalkSpeed = velAtual
    else
        Library:Notify({Title = "TAS", Description = "Vá até o DUMMY VERDE brilhante!", Duration = 3})
        
        -- CRIA O DUMMY E O ÍCONE DE EXCLAMAÇÃO (ALTURA E DISTÂNCIA HORIZONTAL CORRIGIDAS)
        local dummy = nil
        pcall(function()
            character.Archivable = true
            dummy = character:Clone()
            character.Archivable = false
            
            for _, v in ipairs(dummy:GetDescendants()) do
                if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("ModuleScript") then
                    v:Destroy()
                end
            end
            
            for _, v in ipairs(dummy:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.ForceField
                    v.Color = Color3.fromRGB(0, 255, 0)
                    v.CanCollide = false
                    v.CanTouch = false
                    v.Anchored = true
                end
            end
            
            -- Ajuste fino de altura para o dummy ficar perfeitamente em pé no chão (sem afundar)
            local offsetChao = Vector3.new(0, 1.5, 0) 
            local posicaoCorrigida = targetCF + offsetChao
            dummy:PivotTo(posicaoCorrigida)
            
            -- Adiciona a interface da Exclamação acima da cabeça visível através de paredes
            local parteReferencia = dummy:FindFirstChild("Head") or dummy:FindFirstChild("HumanoidRootPart")
            if parteReferencia then
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "ExclamacaoWaypoint"
                billboard.Size = UDim2.new(0, 50, 0, 50)
                billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                billboard.AlwaysOnTop = true
                billboard.Adornee = parteReferencia
                
                local textLabel = Instance.new("TextLabel")
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.Text = "!"
                textLabel.TextColor3 = Color3.fromRGB(255, 230, 0)
                textLabel.TextScaled = true
                textLabel.Font = Enum.Font.FredokaOne
                
                local uiStroke = Instance.new("UIStroke")
                uiStroke.Thickness = 3
                uiStroke.Color = Color3.fromRGB(0, 0, 0)
                uiStroke.Parent = textLabel
                
                textLabel.Parent = billboard
                billboard.Parent = dummy
            end
            
            dummy.Parent = workspace
        end)

        local conectado = nil
        local chegou = false
        
        local function iniciarCaminhadaSuave()
            if chegou then return end
            chegou = true
            if conectado then conectado:Disconnect() end
            
            local velAtual = humanoid.WalkSpeed; humanoid.WalkSpeed = 16
            humanoid:MoveTo(posAlvoExata)
            
            local t0 = os.clock()
            while (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(posAlvoExata.X, 0, posAlvoExata.Z)).Magnitude > 1.2 and (os.clock() - t0) < 2.5 do
                task.wait()
            end
            
            humanoid:MoveTo(rootPart.Position)
            rootPart.AssemblyLinearVelocity, rootPart.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            TweenService:Create(rootPart, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = targetCF}):Play()
            task.wait(0.2)
            humanoid.AutoRotate = true
            humanoid.WalkSpeed = velAtual
            
            if dummy then dummy:Destroy() end
            
            if delayInicio > 0 then task.wait(delayInicio) end
            task.defer(function() reproduzindo = true end)
            Library:Notify({Title = "TAS", Description = "Reproduzindo Rota!", Duration = 3})
        end

        -- Sistema de proximidade corrigido (usa apenas distância horizontal X e Z para evitar falhas)
        conectado = RunService.Heartbeat:Connect(function()
            if not character or not rootPart or (not reproduzindo and slotAtivo == nil) then 
                if conectado then conectado:Disconnect() end
                if dummy then dummy:Destroy() end
                return
            end
            
            local posPlayerPlana = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
            local posAlvoPlana = Vector3.new(posAlvoExata.X, 0, posAlvoExata.Z)
            local distanciaHorizontal = (posPlayerPlana - posAlvoPlana).Magnitude
            
            if distanciaHorizontal <= 3.0 and not chegou then
                iniciarCaminhadaSuave()
            end
        end)
        
        return
    end

    rootPart.AssemblyLinearVelocity, rootPart.AssemblyAngularVelocity = Vector3.zero, Vector3.zero

    if delayInicio > 0 then task.wait(delayInicio) end
    task.defer(function() reproduzindo = true end)
    Library:Notify({Title = "TAS", Description = "Reproduzindo Rota!", Duration = 3})
end

--------------------------------------------------------------------
-- 🎥 TAB 4: TAS (Rica em Funções)
--------------------------------------------------------------------
local TasTab = Window:CreateTab("TAS", false, false)
local TasRecPage = TasTab:CreatePage("Gravação & Execução")

local TasControls = TasRecPage:CreateSection("Rotas Temporárias")
local TasConfig = TasRecPage:CreateSection("Configurações do Motor")
local TasSaved = TasRecPage:CreateSection("Rotas Salvas")

local DropdownRotas = nil

local function atualizarDropdownUI()
    listaDeRotas = {}
    for nomeRota, _ in pairs(rotasSalvas) do table.insert(listaDeRotas, nomeRota) end
    table.sort(listaDeRotas)
    
    if #listaDeRotas == 0 then table.insert(listaDeRotas, "Nenhuma") end
    
    if _G.ZyronX_Dropdowns and _G.ZyronX_Dropdowns["Selecionar Rota"] then
        _G.ZyronX_Dropdowns["Selecionar Rota"]:Refresh(listaDeRotas)
    end
end

-- ROTAS TEMPORÁRIAS
TasControls:AddToggle("Gravar", false, function(state)
    if state then
        reproduzindo = false
        gravacaoTemporaria = {}
        posicaoInicial = rootPart.Position
        tempoDecorrido = 0
        gravando = true
        limparVisualizer(pastaVisualizerTemp)
        if gravarEmSlow then aplicarFisicaSlow(true) end
        Library:Notify({Title = "TAS", Description = "Gravação Iniciada!", Duration = 3})
    else
        gravando = false
        aplicarFisicaSlow(false)
        atualizarVisualizerTemp()
        Library:Notify({Title = "TAS", Description = "Gravação Parada!", Duration = 3})
    end
end, { Title = "Gravar rota temporária" })

TasControls:AddToggle("Mostrar Rota", true, function(state)
    mostrarVisualizerTemp = state
    atualizarVisualizerTemp()
end, { Title = "Exibe a rota da rota temporária" })

TasControls:AddButton("Reproduzir / Parar", function()
    if reproduzindo then
        reproduzindo, slotAtivo = false, nil
        if animTrackAtual then animTrackAtual:Stop(0.2); animTrackAtual = nil; idAnimTocando = nil end
        Library:Notify({Title = "TAS", Description = "Reprodução Parada!", Duration = 3})
    else
        if #gravacaoTemporaria == 0 or not posicaoInicial then
            Library:Notify({Title = "Erro", Description = "Nenhuma gravação temporária!", Duration = 3}); return
        end
        iniciarPlayback({dados = gravacaoTemporaria, posicaoStart = {posicaoInicial.X, posicaoInicial.Y, posicaoInicial.Z}, tempoTotal = tempoDecorrido})
    end
end, { Title = "Reproduz a rota temporária" })

TasControls:AddTextbox("Nome da Rota", "Vazio = Automatico", function(texto)
    nomeCustomizado = texto
end, { Title = "Dê um nome antes de salvar" })

TasControls:AddButton("Salvar Rota", function()
    if #gravacaoTemporaria == 0 or not posicaoInicial then
        Library:Notify({Title = "Erro", Description = "Nenhuma gravação para salvar!", Duration = 3}); return
    end
    
    local nomeFinal = (nomeCustomizado == "" or nomeCustomizado == "Vazio = Automatico") and ("Parkour " .. contadorAutomatico) or nomeCustomizado
    if nomeFinal:match("^Parkour ") then contadorAutomatico = contadorAutomatico + 1 end
    
    local dadosSlot = {dados = HttpService:JSONDecode(HttpService:JSONEncode(gravacaoTemporaria)), posicaoStart = {posicaoInicial.X, posicaoInicial.Y, posicaoInicial.Z}, tempoTotal = tempoDecorrido}
    rotasSalvas[nomeFinal] = dadosSlot
    salvarArquivoRota(nomeFinal, dadosSlot)
    atualizarListaNavegacao(nomeFinal)
    mudarVisualizerSelecionado()
    atualizarDropdownUI()
    
    Library:Notify({Title = "Sucesso", Description = "Rota salva!", Duration = 3})
end, { Title = "Salva a rota temporária" })

-- CONFIGURAÇÕES DO MOTOR
TasConfig:AddSlider("Velocidade de Gravação", 1, 10, 10, function(val) 
    fatorSlow = val / 10
    gravarEmSlow = (fatorSlow < 1.0)
end, { Title = "Velocidade (0.1 a 1.0)" })

TasConfig:AddToggle("MoveTo", false, function(state)
    configSecurity = state
end, { Title = "Ir até o ponto inicial automaticamente" })

-- ROTAS SALVAS
atualizarListaNavegacao()
local rotasDropdownList = #listaDeRotas > 0 and listaDeRotas or {"Nenhuma"}

DropdownRotas = TasSaved:AddDropdown("Selecionar Rota", rotasDropdownList, false, function(selected)
    rotaSelecionada = selected
    mudarVisualizerSelecionado()
end, { Title = "Gerenciar rota salva", Flag = "MenuRotasTAS" })

TasSaved:AddButton("Iniciar / Parar", function()
    if reproduzindo then
        reproduzindo, slotAtivo = false, nil
        if animTrackAtual then animTrackAtual:Stop(0.2); animTrackAtual = nil; idAnimTocando = nil end
        Library:Notify({Title = "TAS", Description = "Reprodução Parada!", Duration = 3})
    else
        if rotaSelecionada ~= "Nenhuma" and rotasSalvas[rotaSelecionada] then
            iniciarPlayback(rotasSalvas[rotaSelecionada])
        else
            Library:Notify({Title = "Erro", Description = "Selecione uma rota!", Duration = 3})
        end
    end
end, { Title = "Inicia ou pausa a rota salva selecionada" })

TasSaved:AddToggle("Ver Rota", true, function(state)
    mostrarVisualizerSelecionada = state
    mudarVisualizerSelecionado()
end, { Title = "Mostra a rota salva selecionada" })

TasSaved:AddTextbox("Renomear", "Novo nome...", function(text)
    if rotaSelecionada ~= "Nenhuma" and rotasSalvas[rotaSelecionada] and text ~= "" and text ~= rotaSelecionada then
        local dadosAntigos = rotasSalvas[rotaSelecionada]
        deletarArquivoRota(rotaSelecionada)
        rotasSalvas[rotaSelecionada] = nil
        rotasSalvas[text] = dadosAntigos
        salvarArquivoRota(text, dadosAntigos)
        atualizarListaNavegacao(text)
        mudarVisualizerSelecionado()
        atualizarDropdownUI()
        
        Library:Notify({Title = "TAS", Description = "Renomeada para " .. text, Duration = 3})
    end
end, { Title = "Renomeia a rota selecionada" })

TasSaved:AddButton("Deletar Rota", function()
    if rotaSelecionada ~= "Nenhuma" and rotasSalvas[rotaSelecionada] then
        deletarArquivoRota(rotaSelecionada)
        rotasSalvas[rotaSelecionada] = nil
        atualizarListaNavegacao()
        mudarVisualizerSelecionado()
        atualizarDropdownUI()
        
        Library:Notify({Title = "TAS", Description = "Rota apagada!", Duration = 3})
    end
end, { Title = "Apaga a rota selecionada" })
local Players = game:GetService("Players")
local player = Players.LocalPlayer -- Garantindo que a variável player exista para pegar o próprio nick

--------------------------------------------------------------------
-- 👁️ VARIÁVEIS DO VISUAL
--------------------------------------------------------------------
local Fardas = {
    ["Nenhuma"] = nil,
    ["Oficiais"] = {S = "rbxassetid://14825639654", P = "rbxassetid://14825643510"},
    ["Generais"] = {S = "rbxassetid://278436685", P = "rbxassetid://278437052"},
    ["Elite"] = {S = "rbxassetid://75117162625698", P = "rbxassetid://132857388083739"}
}
local backups = {}
local inputTargetNick, inputDisplayNick, inputPatente, inputDivisao = "", "", "", ""
local selectedColor = Color3.fromRGB(192, 0, 255) -- Padrão: Vermelho Escarlate
local usarTag = true
local fardaSelecionada = "Nenhuma"
local cargoStatus = "LIGTH" -- Padrão
local deviceIcon = "🎮" -- Padrão Console
local fullBrightConn

--------------------------------------------------------------------
-- 👁️ TAB 5: VISUAL (INTERFACE E LÓGICA)
--------------------------------------------------------------------
local VisualTab = Window:CreateTab("Visual", false, false)
local VisualPage = VisualTab:CreatePage("Geral")

local VisualDisfarceCard = VisualPage:CreateSection("Disfarçar (Overhead & Farda)")

-- Atualizei o texto de dica da caixa do alvo para avisar sobre o "all"
VisualDisfarceCard:AddTextbox("Modificar o player", "Vazio = você | 'all' = todos", function(text) inputTargetNick = text end, { Title = "Alvo" })
VisualDisfarceCard:AddTextbox("Nick Exibição", "Vazio = princesinho0004", function(text) inputDisplayNick = text end, { Title = "Display" })
VisualDisfarceCard:AddTextbox("Patente", "Vazio = [CR] Criador", function(text) inputPatente = text end, { Title = "Patente" })
VisualDisfarceCard:AddTextbox("Divisão", "Vazio = discord.gg/havac", function(text) inputDivisao = text end, { Title = "Divisão" })

VisualDisfarceCard:AddDropdown("Dispositivo", {"🎮", "🖥️", "📱"}, false, function(selected) deviceIcon = selected end, { Title = "Dispositivo" })
VisualDisfarceCard:AddToggle("Ativar club", true, function(state) usarTag = state end, { Title = "Club Tag" })
VisualDisfarceCard:AddDropdown("Selecionar club", {"LIGTH", "ELITE", "VICE"}, false, function(selected) cargoStatus = selected end, { Title = "Cargo" })

-- Sistema de Fardas adicionado
VisualDisfarceCard:AddDropdown("Selecionar Farda", {"Nenhuma", "Oficiais", "Generais", "Elite"}, false, function(selected) 
    fardaSelecionada = selected 
end, { Title = "Mudar Roupa" })

-- O ColorPicker focado no padrão Escarlate
VisualDisfarceCard:AddColorPicker("Cor da Overhead", selectedColor, function(color)
    selectedColor = color
end, { Title = "Cor do Texto" })


VisualDisfarceCard:AddButton("Aplicar Disfarce", function()
    local targetInput = string.lower(inputTargetNick)
    
    -- Função local para não repetir código
    local function applyDisguise(targetName, targetChar)
        if not targetChar or not targetChar:FindFirstChild("Head") then return end

        local head = targetChar.Head
        local labelNome = head:FindFirstChild("Nome", true) and head:FindFirstChild("Nome", true):FindFirstChildOfClass("TextLabel")
        local labelPatente = head:FindFirstChild("Patente", true) and head:FindFirstChild("Patente", true):FindFirstChildOfClass("TextLabel")
        local labelDivisao = (head:FindFirstChild("Divis\195\163o", true) or head:FindFirstChild("Divisão", true)) and (head:FindFirstChild("Divis\195\163o", true) or head:FindFirstChild("Divisão", true)):FindFirstChildOfClass("TextLabel")
        
        local shirt = targetChar:FindFirstChildOfClass("Shirt")
        local pants = targetChar:FindFirstChildOfClass("Pants")

        -- Sistema de Backup para poder restaurar depois (roupas e textos)
        if not backups[targetName] then
            backups[targetName] = {
                ShirtTemplate = shirt and shirt.ShirtTemplate or nil, 
                PantsTemplate = pants and pants.PantsTemplate or nil,
                NomeText = labelNome and labelNome.Text or nil, 
                NomeColor = labelNome and labelNome.TextColor3 or nil,
                PatenteText = labelPatente and labelPatente.Text or nil, 
                PatenteColor = labelPatente and labelPatente.TextColor3 or nil,
                DivisaoText = labelDivisao and labelDivisao.Text or nil, 
                DivisaoColor = labelDivisao and labelDivisao.TextColor3 or nil,
            }
        end

        -- Aplicando os padrões (fallbacks) se o usuário deixou a caixa de texto em branco
        local finalNick = inputDisplayNick ~= "" and inputDisplayNick or "princesinho0004"
        local finalPatente = inputPatente ~= "" and inputPatente or "[CR] Criador"
        local finalDivisao = inputDivisao ~= "" and inputDivisao or "discord.gg/havac"

        local formattedName = usarTag and string.format("[%s] %s • %s", cargoStatus, deviceIcon, finalNick) or string.format("%s • %s", deviceIcon, finalNick)

        -- Aplicando os textos e a cor
        if labelNome then labelNome.Text = formattedName; labelNome.TextColor3 = selectedColor end
        if labelPatente then labelPatente.Text = finalPatente; labelPatente.TextColor3 = selectedColor end
        if labelDivisao then labelDivisao.Text = finalDivisao; labelDivisao.TextColor3 = selectedColor end

        -- Aplicando a Farda (se o usuário selecionou uma)
        if fardaSelecionada ~= "Nenhuma" and Fardas[fardaSelecionada] then
            if shirt then shirt.ShirtTemplate = Fardas[fardaSelecionada].S end
            if pants then pants.PantsTemplate = Fardas[fardaSelecionada].P end
        end
    end

    -- Lógica para verificar se é "all" ou um jogador específico
    if targetInput == "all" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                applyDisguise(plr.Name, plr.Character)
            end
        end
        Library:Notify({Title="Sucesso", Description="Disfarce aplicado em TODOS!", Duration=3})
    else
        local targetName = inputTargetNick ~= "" and inputTargetNick or player.Name
        local targetChar = workspace:FindFirstChild(targetName)
        
        if targetChar then
            applyDisguise(targetName, targetChar)
            Library:Notify({Title="Sucesso", Description="Disfarce aplicado em: " .. targetName, Duration=3})
        else
            Library:Notify({Title="Erro", Description="Jogador não encontrado no mapa!", Duration=3})
        end
    end
end)

VisualDisfarceCard:AddButton("Desfazer Disfarce", function()
    local targetInput = string.lower(inputTargetNick)

    -- Função local para não repetir código
    local function undoDisguise(targetName, targetChar)
        if not targetChar or not targetChar:FindFirstChild("Head") then return end

        local backup = backups[targetName]
        if not backup then return end -- Ignora se não houver backup

        local head = targetChar.Head
        local labelNome = head:FindFirstChild("Nome", true) and head:FindFirstChild("Nome", true):FindFirstChildOfClass("TextLabel")
        local labelPatente = head:FindFirstChild("Patente", true) and head:FindFirstChild("Patente", true):FindFirstChildOfClass("TextLabel")
        local labelDivisao = (head:FindFirstChild("Divis\195\163o", true) or head:FindFirstChild("Divisão", true)) and (head:FindFirstChild("Divis\195\163o", true) or head:FindFirstChild("Divisão", true)):FindFirstChildOfClass("TextLabel")
        local shirt = targetChar:FindFirstChildOfClass("Shirt")
        local pants = targetChar:FindFirstChildOfClass("Pants")

        -- Restaurando Textos
        if labelNome and backup.NomeText then labelNome.Text = backup.NomeText; labelNome.TextColor3 = backup.NomeColor end
        if labelPatente and backup.PatenteText then labelPatente.Text = backup.PatenteText; labelPatente.TextColor3 = backup.PatenteColor end
        if labelDivisao and backup.DivisaoText then labelDivisao.Text = backup.DivisaoText; labelDivisao.TextColor3 = backup.DivisaoColor end
        
        -- Restaurando Roupas originais
        if backup.ShirtTemplate and shirt then shirt.ShirtTemplate = backup.ShirtTemplate end
        if backup.PantsTemplate and pants then pants.PantsTemplate = backup.PantsTemplate end
    end

    -- Lógica para verificar se é "all" ou um jogador específico
    if targetInput == "all" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                undoDisguise(plr.Name, plr.Character)
            end
        end
        Library:Notify({Title="Restaurado", Description="Aparência de TODOS foi restaurada.", Duration=3})
    else
        local targetName = inputTargetNick ~= "" and inputTargetNick or player.Name
        local targetChar = workspace:FindFirstChild(targetName)
        
        if targetChar then
            if not backups[targetName] then 
                Library:Notify({Title="Aviso", Description="Nenhum backup encontrado para " .. targetName, Duration=3})
                return 
            end
            undoDisguise(targetName, targetChar)
            Library:Notify({Title="Restaurado", Description="Aparência original de " .. targetName .. " restaurada.", Duration=3})
        else
            Library:Notify({Title="Erro", Description="Jogador não encontrado no mapa!", Duration=3})
        end
    end
end)

local OtimizacaoCard = VisualPage:CreateSection("Otimização & Câmera")
OtimizacaoCard:AddSlider("FOV da Câmera", 70, 120, 70, function(val) workspace.CurrentCamera.FieldOfView = val end, { Title = "Campo de Visão" })
OtimizacaoCard:AddSlider("Max Zoom Distance", 10, 400, 128, function(val) if player then player.CameraMaxZoomDistance = val end end, { Title = "Zoom Máximo" })

OtimizacaoCard:AddButton("Remover Texturas (Boost)", function()
    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and not v:IsA("Terrain") then v.Material = Enum.Material.SmoothPlastic; v.Reflectance = 0; v.CastShadow = false end
        end
        Lighting.GlobalShadows = false
    end)
    Library:Notify({Title="Otimização", Description="Texturas removidas com sucesso!", Duration=3})
end)

OtimizacaoCard:AddToggle("Fullbright", false, function(state)
    if state then
        fullBrightConn = RunService.RenderStepped:Connect(function()
            Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd, Lighting.GlobalShadows = 2, 14, 100000, false
        end)
    else
        if fullBrightConn then fullBrightConn:Disconnect(); fullBrightConn = nil end
        Lighting.Brightness, Lighting.ClockTime, Lighting.GlobalShadows = 1, 12, true
    end
end, { Title = "Visão Noturna" })

Library:Notify({
    Title = "Módulo Visual",
    Description = "Interface visual carregada!",
    Duration = 5
})
