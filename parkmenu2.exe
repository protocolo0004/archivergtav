-- 🖥️ UI: AUTO FARM CARD
-- ========================================== --
local AutoFarmCard = Havac_Page:CreateSection("Auto Farm")

AutoFarmCard:AddToggle("Ativar Auto Quest", false, function(state)
    autoMissaoAtivo = state
    if autoMissaoAtivo then
        Library:Notify({ Title = "Auto Quest", Description = "Iniciando a missão automaticamente...", Duration = 3 })
        iniciarAutoMissao()
    else
        Library:Notify({ Title = "Auto Quest", Description = "Parado.", Duration = 3 })
    end
end, { Title = "Faz sua missão atual sozinho" })

AutoFarmCard:AddButton("Coletar Todos os Troféus", function()
    if not farmTrofeuRunning then
        Library:Notify({ Title = "Troféus", Description = "Coletando troféus com Micro-TP...", Duration = 3 })
        iniciarColetaTrofeus()
    else
        Library:Notify({ Title = "Aviso", Description = "Os troféus já estão sendo coletados!", Duration = 3 })
    end
end)

AutoFarmCard:AddDropdown("Tipo de Coleta", {"Coletar Lixo", "Coletar Grama", "Ambos (Mesclado)"}, false, function(selected)
    modoSelecionado = selected
    if farmAtivo then
        farmAtivo = false
